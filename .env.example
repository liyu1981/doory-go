# Configuration for the single binary (D1/D4). Copy to `.env` for
# `docker compose`, or export the variables before `doory serve`.
#
# With NONE of this set the binary still runs: it keeps its SQLite database,
# media and exports under ./data (DOORY_DATA_DIR) and serves on :8000. Set
# DJANGO_SECRET_KEY and SITE_URL for anything beyond localhost.

# ---- Required outside localhost ----
# Public address of the site, with scheme and no trailing slash (emails, CSRF checks).
SITE_URL=http://localhost:8080
# Long random value, e.g.  openssl rand -base64 48   (changing it signs everyone out)
DJANGO_SECRET_KEY=
# Hostnames the API answers to, comma separated (a leading dot also matches subdomains).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Storage (D4) ----
# One directory holds everything that must survive: doory.sqlite3, media/, exports/.
# In Docker this is the /app/data volume.
DOORY_DATA_DIR=./data
# Override the individual paths if you keep them elsewhere (S3 for media is not
# ported yet — see PORT_MAP).
# MEDIA_ROOT=./data/media
# EXPORT_STORAGE_ROOT=./data/exports
# Use PostgreSQL instead of the embedded SQLite file (same binary; D4):
# DATABASE_URL=postgres://doory:secret@db:5432/doory

# ---- HTTPS ----
# The defaults below let you try Doory over plain http://localhost. Behind a
# TLS-terminating proxy (production), set both to true.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false
# Reverse proxies between the internet and the API, as seen by rate limiting.
NUM_PROXIES=1

# ---- Container ports (docker compose) ----
WEB_PORT=8080
# Interface the web port is published on. Use 127.0.0.1 when a reverse proxy on
# the same host fronts it.
WEB_BIND=0.0.0.0
# Build headless Chromium into the image for server-side PDF export (adds ~400 MB).
INSTALL_CHROMIUM=true
# Server-side export needs Chromium; the image sets these when INSTALL_CHROMIUM=true.
# SERVER_PDF_ENABLED=true
# SERVER_IMAGE_EXPORT_ENABLED=true
# EXPORT_CHROMIUM_PATH=/usr/bin/chromium
# EXPORT_CHROMIUM_NO_SANDBOX=true
# EXPORT_RENDER_PAGE_URL=http://localhost:8080/render.html

# ---- Real-time co-editing ----
# REALTIME_ENABLED=true
# REALTIME_MAX_FRAME_BYTES=1048576
# REALTIME_MAX_CONNECTIONS_PER_DESIGN=25
# REALTIME_MAX_CONNECTIONS_PER_USER=10
# REALTIME_AUTH_TIMEOUT_SECONDS=10
# REALTIME_IDLE_TIMEOUT_SECONDS=120
# REALTIME_FLUSH_INTERVAL_SECONDS=10
# REALTIME_RECHECK_SECONDS=5
# REALTIME_COMPACT_AFTER_UPDATES=200

# ---- MCP server for AI assistants (/mcp) ----
# Off by default; clients authenticate with a personal access token
# (Settings → API tokens in the app, or POST /api/v1/tokens/).
MCP_ENABLED=false
# MCP_PATH=/mcp
# MCP_CALLS_PER_MINUTE=120
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_EXPORT_INLINE_MAX_BYTES=1048576
# MCP_EXPORT_URL_TTL_SECONDS=600

# ---- First-run content (the commands are the upstream management commands) ----
# Without it a new site has no icons, emoji or illustrations, no fonts besides
# the system ones and no background-removal model. These flags run the
# downloads inside `doory entrypoint` *before* it starts serving; a failed
# download is logged and never stops the server. The first start can take
# minutes, so for a first install you may prefer `docker compose exec doory
# doory <command>` once the stack is up, and these flags afterwards.
# Template categories: doory seed_gallery

# Element library (icons, emoji, illustrations, shapes, graphics): about 27 500
# elements, about 40 s and 120-130 MB on disk the first time. true: run on every start.
DOORY_SYNC_ELEMENTS=false
# Extra arguments for `sync_element_packs`, e.g. --pack lucide phosphor-regular
DOORY_SYNC_ELEMENTS_ARGS=
# Brand logos (Facebook, LinkedIn, YouTube, ...) from the icon sets. Off by
# default: logos are trademarks of their owners. false again: the next sync
# unpublishes them (designs that already use a logo keep their copy).
DOORY_ELEMENTS_BRAND_LOGOS=false

# Font catalog (OFL fonts from Fontsource via jsDelivr). true: download once, on the first start.
DOORY_SYNC_FONTS=false
# Which families (default when empty: the 100 most popular, about 6 MB).
DOORY_SYNC_FONTS_ARGS=

# The ten starter templates (embedded, with thumbnails). true: add them on every
# start. Add-only: a template that already exists is never changed.
DOORY_SEED_TEMPLATES=false

# Background-removal model (U2-Net small, Apache-2.0, 4.6 MB, into MEDIA_ROOT/models/).
DOORY_SYNC_MODELS=false
# Extra arguments for `sync_models`, e.g. --model u2net (176 MB) or --all
DOORY_SYNC_MODELS_ARGS=

# Audio library (24 music loops and 88 sound effects, CC0, about 7 MB): installed
# from the embedded files, no download.
DOORY_SYNC_AUDIO=false
# Extra arguments for `sync_audio`, e.g. --pack some-pack
DOORY_SYNC_AUDIO_ARGS=

# Your own size presets catalogue (JSON; see `doory import_size_presets`).
# DOORY_SIZE_PRESETS_FILE=/config/size-presets.json
# DOORY_SIZE_PRESETS_MODE=extend

# ---- AI providers (offline model server) ----
# AI_PROVIDERS_ENABLED=true
# AI_USER_PROVIDERS=off        # off | staff | everyone
# AI_OFFSITE_NOTICE=
# AI_SECRETS_KEY=              # Fernet key; default derives from DJANGO_SECRET_KEY
# AI_SECRETS_KEY_FALLBACKS=
# AI_ALLOWED_PRIVATE_HOSTS=
# AI_DEFAULT_TIMEOUT_SECONDS=30
# AI_MAX_IMAGE_BYTES=
# AI_MAX_PROVIDERS_PER_USER=5
# AI_USER_PROVIDERS_ALLOW_HTTP=false
# AI_USER_PROVIDERS_ALLOWED_PORTS=

# ---- Stock providers (empty = the no-configuration behaviour) ----
# STOCK_PROVIDERS=unsplash,pexels,pixabay
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# FREESOUND_ACCESS_KEY=

# ---- Limits ----
# MAX_DESIGNS_PER_USER=100
# MAX_API_TOKENS_PER_USER=20
# USER_STORAGE_QUOTA_BYTES=536870912
# BULK_FILL_MAX_ROWS=100

# ---- Local development ----
# Serve the API while proxying every page request to the Vite dev server
# (the mirror image of frontend/vite.config.ts's server.proxy).
# DOORY_DEV_PROXY=http://127.0.0.1:5173
