# The upstream mirror is recreated by `make upstream-mirror` and verified
# against internal/dooryversion by test/upstream-parity.
.upstream/

# Media/db scratch from local oracle runs.
backend/db.sqlite3
backend/media/
backend/staticfiles/
# The Go app's default MEDIA_ROOT (repo-root media/): runtime uploads from
# local runs and the parity suite; never tracked (housekeeping commit).
media/
*.pyc
__pycache__/
.venv/

# Build output.
node_modules/
doory
/dist/

# Oracle scratch: venv, probe DBs, media (must stay outside the mirror).

.oracle/
*.sqlite3
