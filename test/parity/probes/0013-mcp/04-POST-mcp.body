{"jsonrpc":"2.0","id":2,"result":{"tools":[{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List uploads"},"description":"Your uploaded pictures, newest first. Place one with edit_design:\n    {\"op\": \"add_image\", \"asset_id\": …}.","inputSchema":{"properties":{"query":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"description":"Words in the name.","title":"Query"},"limit":{"default":30,"maximum":100,"minimum":1,"title":"Limit","type":"integer"}},"type":"object","title":"list_assetsArguments"},"name":"list_assets","outputSchema":{"type":"object","additionalProperties":true,"title":"list_assetsDictOutput"},"title":"List uploads"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search stock photos"},"description":"Search free stock photos. Use import_stock_photo to add one to your uploads before placing it.","inputSchema":{"properties":{"query":{"maxLength":100,"minLength":1,"title":"Query","type":"string"},"provider":{"anyOf":[{"enum":["unsplash","pexels","pixabay"],"type":"string"},{"type":"null"}],"default":null,"title":"Provider"},"page":{"default":1,"maximum":100,"minimum":1,"title":"Page","type":"integer"},"per_page":{"default":12,"maximum":30,"minimum":1,"title":"Per Page","type":"integer"}},"required":["query"],"type":"object","title":"search_stock_photosArguments"},"name":"search_stock_photos","outputSchema":{"type":"object","additionalProperties":true,"title":"search_stock_photosDictOutput"},"title":"Search stock photos"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Import a stock photo"},"description":"Copy a stock photo into your uploads (once; importing it again returns the same asset). With\n    remove_background, the transparent cut-out is returned instead (a second upload), with the `model`.","inputSchema":{"properties":{"provider":{"enum":["unsplash","pexels","pixabay"],"title":"Provider","type":"string"},"photo_id":{"description":"`id` from search_stock_photos.","maxLength":64,"minLength":1,"title":"Photo Id","type":"string"},"remove_background":{"default":false,"description":"Remove the photo's background immediately upon import (uses an AI server model).","title":"Remove Background","type":"boolean"},"model":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"A server model from list_ai_models; omitted: its `server_default`.","title":"Model"}},"required":["provider","photo_id"],"type":"object","title":"import_stock_photoArguments"},"name":"import_stock_photo","outputSchema":{"type":"object","additionalProperties":true,"title":"import_stock_photoDictOutput"},"title":"Import a stock photo"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Upload an image from a URL"},"description":"Copy an image from a public https URL into your uploads; it is checked like any upload. Only use\n    images the user has the right to use. With remove_background, the transparent cut-out is returned instead\n    (a second upload), with the `model` used.","inputSchema":{"properties":{"url":{"description":"A public https link to an image.","maxLength":2048,"minLength":8,"title":"Url","type":"string"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"remove_background":{"default":false,"description":"Remove the image's background upon upload (uses an AI server model).","title":"Remove Background","type":"boolean"},"model":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"A server model from list_ai_models; omitted: its `server_default`.","title":"Model"}},"required":["url"],"type":"object","title":"upload_image_from_urlArguments"},"name":"upload_image_from_url","outputSchema":{"type":"object","additionalProperties":true,"title":"upload_image_from_urlDictOutput"},"title":"Upload an image from a URL"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search sounds"},"description":"Search free sounds on Freesound (music, sound effects, ambience), when the server has a key. Only\n    the licences the server allows are returned (CC0 by default). A result with `credit_required: true`\n    (CC BY) must be credited wherever the design is published; get_design_credits gives the text. Use\n    import_audio to add one to your uploads.","inputSchema":{"properties":{"query":{"default":"","description":"Words to search; may be empty.","maxLength":100,"title":"Query","type":"string"},"type":{"default":"all","enum":["all","music","effects","ambience"],"title":"Type","type":"string"},"length":{"default":"any","enum":["any","short","medium","long","extended"],"title":"Length","type":"string"},"sort":{"default":"relevance","enum":["relevance","rating","downloads","newest","shortest"],"title":"Sort","type":"string"},"page":{"default":1,"maximum":100,"minimum":1,"title":"Page","type":"integer"},"per_page":{"default":12,"maximum":30,"minimum":1,"title":"Per Page","type":"integer"}},"type":"object","title":"search_audioArguments"},"name":"search_audio","outputSchema":{"type":"object","additionalProperties":true,"title":"search_audioDictOutput"},"title":"Search sounds"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Import a sound"},"description":"Copy a Freesound sound into your audio uploads (once; importing it again returns the same asset). The\n    answer includes its `credit`.","inputSchema":{"properties":{"sound_id":{"description":"`id` from search_audio.","maxLength":12,"minLength":1,"title":"Sound Id","type":"string"}},"required":["sound_id"],"type":"object","title":"import_audioArguments"},"name":"import_audio","outputSchema":{"type":"object","additionalProperties":true,"title":"import_audioDictOutput"},"title":"Import a sound"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get a design's credits"},"description":"The credits a design owes for the sounds it uses. `credits_text` lists the ones that must be\n    credited (CC BY), one line each, ready to paste into a post's caption or a video description; it is\n    empty when nothing needs credit.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"}},"required":["design_id"],"type":"object","title":"get_design_creditsArguments"},"name":"get_design_credits","outputSchema":{"type":"object","additionalProperties":true,"title":"get_design_creditsDictOutput"},"title":"Get a design's credits"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List designs"},"description":"List your designs, most recently changed first.","inputSchema":{"properties":{"query":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"description":"Words in the title.","title":"Query"},"starred":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Starred"},"folder_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Only designs directly in this folder (from list_folders).","title":"Folder Id"},"in_trash":{"default":false,"description":"List the trash instead (see restore_design).","title":"In Trash","type":"boolean"},"limit":{"default":20,"maximum":100,"minimum":1,"title":"Limit","type":"integer"},"offset":{"default":0,"minimum":0,"title":"Offset","type":"integer"}},"type":"object","title":"list_designsArguments"},"name":"list_designs","outputSchema":{"type":"object","additionalProperties":true,"title":"list_designsDictOutput"},"title":"List designs"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Read a design"},"description":"Read a design: its pages and, on each page, every object (bottom to top) with its id, kind, box\n    (x, y = top-left corner, width, height in page pixels) and main style. Use the ids with edit_design.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"include_document":{"default":false,"description":"Also return the full document JSON (large; rarely needed).","title":"Include Document","type":"boolean"}},"required":["design_id"],"type":"object","title":"get_designArguments"},"name":"get_design","outputSchema":{"type":"object","additionalProperties":true,"title":"get_designDictOutput"},"title":"Read a design"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List template fields"},"description":"The template fields of a design: objects tagged with a field key (set with edit_design →\n    update_object `field`), one entry per key, with its type (text, image, color), label, pages, object ids\n    and current value. Photo placeholders without a tag are listed as suggested image fields (`key: null`).","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"}},"required":["design_id"],"type":"object","title":"list_fieldsArguments"},"name":"list_fields","outputSchema":{"type":"object","additionalProperties":true,"title":"list_fieldsDictOutput"},"title":"List template fields"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create a design"},"description":"Create a design: from a template, or blank at the given size (e.g. 1080 x 1350 for an Instagram\n    portrait post, 1920 x 1080 for a slide, 794 x 1123 for A4 portrait).","inputSchema":{"properties":{"title":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Title"},"template":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"A template slug from list_templates.","title":"Template"},"width":{"anyOf":[{"maximum":20000,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"description":"Pixels; default 1080.","title":"Width"},"height":{"anyOf":[{"maximum":20000,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Height"}},"type":"object","title":"create_designArguments"},"name":"create_design","outputSchema":{"type":"object","additionalProperties":true,"title":"create_designDictOutput"},"title":"Create a design"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Rename a design"},"description":"Change a design's title.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"title":{"maxLength":200,"minLength":1,"title":"Title","type":"string"}},"required":["design_id","title"],"type":"object","title":"rename_designArguments"},"name":"rename_design","outputSchema":{"type":"object","additionalProperties":true,"title":"rename_designDictOutput"},"title":"Rename a design"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Duplicate a design"},"description":"Copy a design; the copy is a new design you can change without touching the original.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"}},"required":["design_id"],"type":"object","title":"duplicate_designArguments"},"name":"duplicate_design","outputSchema":{"type":"object","additionalProperties":true,"title":"duplicate_designDictOutput"},"title":"Duplicate a design"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Edit a design"},"description":"Change a design with a list of operations, applied in order and all or nothing: add text, shapes\n    (basic ones, or catalogue shapes such as heart, arrow-right, speech, cloud with shape `path`), lines,\n    pictures and QR codes; update, arrange, group, ungroup or delete objects; add, move or delete pages; set\n    backgrounds and speaker notes; remove backgrounds from pictures (remove_background). Read the design first\n    (get_design) to know page and object ids.\n\n    Coordinates are page pixels from the top-left corner; x, y place the top-left corner of an object's box.\n    Text boxes wrap at their width and their height follows the text; the server estimates text height\n    (the editor measures it exactly when the design is opened). If the design is open in someone's editor,\n    the change appears there live.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"operations":{"items":{"discriminator":{"mapping":{"add_image":"#/$defs/AddImage","add_line":"#/$defs/AddLine","add_page":"#/$defs/AddPage","add_qr_code":"#/$defs/AddQrCode","add_shape":"#/$defs/AddShape","add_text":"#/$defs/AddText","arrange_object":"#/$defs/ArrangeObject","delete_objects":"#/$defs/DeleteObjects","delete_page":"#/$defs/DeletePage","group_objects":"#/$defs/GroupObjects","move_page":"#/$defs/MovePage","remove_background":"#/$defs/RemoveBackground","replace_image":"#/$defs/ReplaceImage","set_background":"#/$defs/SetBackground","set_notes":"#/$defs/SetNotes","ungroup":"#/$defs/Ungroup","update_object":"#/$defs/UpdateObject"},"propertyName":"op"},"oneOf":[{"$ref":"#/$defs/AddText"},{"$ref":"#/$defs/AddShape"},{"$ref":"#/$defs/AddLine"},{"$ref":"#/$defs/AddImage"},{"$ref":"#/$defs/ReplaceImage"},{"$ref":"#/$defs/RemoveBackground"},{"$ref":"#/$defs/AddQrCode"},{"$ref":"#/$defs/UpdateObject"},{"$ref":"#/$defs/DeleteObjects"},{"$ref":"#/$defs/ArrangeObject"},{"$ref":"#/$defs/GroupObjects"},{"$ref":"#/$defs/Ungroup"},{"$ref":"#/$defs/AddPage"},{"$ref":"#/$defs/DeletePage"},{"$ref":"#/$defs/MovePage"},{"$ref":"#/$defs/SetBackground"},{"$ref":"#/$defs/SetNotes"}]},"maxItems":200,"minItems":1,"title":"Operations","type":"array"},"base_revision":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"description":"The revision you read; the edit is refused if the design changed since. Optional. Not checked while the design is open in the editor: the edit then joins the live session.","title":"Base Revision"}},"required":["design_id","operations"],"type":"object","$defs":{"AddImage":{"additionalProperties":false,"description":"Add a picture: one of your uploads (`asset_id`) or a catalogue graphic (`element_id`). It is scaled\nto fit inside width x height with its proportions kept.","properties":{"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new object, so later operations in this call can refer to it.","title":"Id"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"Layer name.","title":"Name"},"index":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Stacking position (0 = bottom). Default: on top.","title":"Index"},"op":{"const":"add_image","title":"Op","type":"string"},"asset_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"From list_assets or import_stock_photo.","title":"Asset Id"},"element_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"From search_elements.","title":"Element Id"},"x":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"description":"Top-left corner of the object's box in page pixels (before rotation). Default: centred.","title":"X"},"y":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"title":"Y"},"width":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"title":"Width"},"height":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"title":"Height"},"mask":{"anyOf":[{"enum":["circle","rounded","triangle","diamond","hexagon","star","heart","blob","arch","cross"],"type":"string"},{"type":"null"}],"default":null,"description":"Crop the picture to a shape (uploaded pictures only).","title":"Mask"},"mask_radius":{"anyOf":[{"maximum":0.5,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Corner radius of the `rounded` mask, as a fraction of the shorter side (default 0.18).","title":"Mask Radius"}},"required":["op"],"title":"AddImage","type":"object"},"AddLine":{"additionalProperties":false,"description":"Add a straight line or arrow from (x1, y1) to (x2, y2).","properties":{"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new object, so later operations in this call can refer to it.","title":"Id"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"Layer name.","title":"Name"},"index":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Stacking position (0 = bottom). Default: on top.","title":"Index"},"op":{"const":"add_line","title":"Op","type":"string"},"x1":{"maximum":100000,"minimum":-100000,"title":"X1","type":"number"},"y1":{"maximum":100000,"minimum":-100000,"title":"Y1","type":"number"},"x2":{"maximum":100000,"minimum":-100000,"title":"X2","type":"number"},"y2":{"maximum":100000,"minimum":-100000,"title":"Y2","type":"number"},"color":{"default":"#1c1517","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"},"width":{"default":6,"description":"Stroke width.","exclusiveMinimum":0,"maximum":1000,"title":"Width","type":"number"},"arrow_start":{"default":"none","enum":["none","triangle","open","circle","diamond"],"title":"Arrow Start","type":"string"},"arrow_end":{"default":"none","enum":["none","triangle","open","circle","diamond"],"title":"Arrow End","type":"string"},"dash":{"anyOf":[{"items":{"maximum":1000,"minimum":0,"type":"number"},"maxItems":8,"type":"array"},{"type":"null"}],"default":null,"title":"Dash"}},"required":["op","x1","y1","x2","y2"],"title":"AddLine","type":"object"},"AddPage":{"additionalProperties":false,"description":"Add a blank page.","properties":{"op":{"const":"add_page","title":"Op","type":"string"},"after":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page to add it after. Default: at the end.","title":"After"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new page.","title":"Id"},"background_color":{"default":"#ffffff","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Background Color","type":"string"},"width":{"anyOf":[{"maximum":20000,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"description":"Default: the design size.","title":"Width"},"height":{"anyOf":[{"maximum":20000,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Height"}},"required":["op"],"title":"AddPage","type":"object"},"AddQrCode":{"additionalProperties":false,"description":"Add a QR code that encodes `text` (usually a URL).","properties":{"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new object, so later operations in this call can refer to it.","title":"Id"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"Layer name.","title":"Name"},"index":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Stacking position (0 = bottom). Default: on top.","title":"Index"},"op":{"const":"add_qr_code","title":"Op","type":"string"},"text":{"maxLength":1000,"minLength":1,"title":"Text","type":"string"},"x":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"description":"Top-left corner of the object's box in page pixels (before rotation). Default: centred.","title":"X"},"y":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"title":"Y"},"size":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"title":"Size"},"color":{"default":"#000000","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"},"background":{"default":"#ffffff","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Background","type":"string"}},"required":["op","text"],"title":"AddQrCode","type":"object"},"AddShape":{"additionalProperties":false,"description":"Add a basic shape.","properties":{"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new object, so later operations in this call can refer to it.","title":"Id"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"Layer name.","title":"Name"},"index":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Stacking position (0 = bottom). Default: on top.","title":"Index"},"op":{"const":"add_shape","title":"Op","type":"string"},"shape":{"description":"`path` = a catalogue shape, named in `path_shape`.","enum":["rect","ellipse","triangle","polygon","star","path"],"title":"Shape","type":"string"},"path_shape":{"anyOf":[{"enum":["heart","speech","arrow-right","cross","diamond","trapezoid","parallelogram","ring","cloud","bolt","chevron","banner","moon","drop"],"type":"string"},{"type":"null"}],"default":null,"description":"With shape `path`.","title":"Path Shape"},"x":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"description":"Top-left corner of the object's box in page pixels (before rotation). Default: centred.","title":"X"},"y":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"title":"Y"},"width":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"title":"Width"},"height":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"title":"Height"},"fill":{"anyOf":[{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","type":"string"},{"type":"null"}],"default":null,"title":"Fill"},"stroke":{"anyOf":[{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","type":"string"},{"type":"null"}],"default":null,"title":"Stroke"},"stroke_width":{"default":0,"maximum":1000,"minimum":0,"title":"Stroke Width","type":"number"},"corner_radius":{"default":0,"description":"rect only.","maximum":100000,"minimum":0,"title":"Corner Radius","type":"number"},"sides":{"default":6,"description":"polygon only.","maximum":12,"minimum":3,"title":"Sides","type":"integer"},"star_tips":{"default":5,"description":"star only.","maximum":24,"minimum":3,"title":"Star Tips","type":"integer"},"inner_ratio":{"default":0.45,"description":"star only.","maximum":0.95,"minimum":0.1,"title":"Inner Ratio","type":"number"},"shadow":{"anyOf":[{"$ref":"#/$defs/ShadowEffect"},{"type":"null"}],"default":null}},"required":["op","shape"],"title":"AddShape","type":"object"},"AddText":{"additionalProperties":false,"description":"Add a text box. The text wraps inside `width`; its height follows from the text.","properties":{"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new object, so later operations in this call can refer to it.","title":"Id"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"Layer name.","title":"Name"},"index":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Stacking position (0 = bottom). Default: on top.","title":"Index"},"op":{"const":"add_text","title":"Op","type":"string"},"text":{"maxLength":20000,"minLength":1,"title":"Text","type":"string"},"preset":{"default":"body","description":"Starting style; explicit fields override it.","enum":["heading","subheading","body"],"title":"Preset","type":"string"},"x":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"description":"Top-left corner of the object's box in page pixels (before rotation). Default: centred.","title":"X"},"y":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"title":"Y"},"width":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"description":"Width the text wraps at. Default: depends on the preset.","title":"Width"},"font_family":{"anyOf":[{"maxLength":120,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"A family from search_fonts, e.g. 'Playfair Display'.","title":"Font Family"},"font_size":{"anyOf":[{"exclusiveMinimum":0,"maximum":2000,"type":"number"},{"type":"null"}],"default":null,"title":"Font Size"},"font_weight":{"anyOf":[{"maximum":900,"minimum":100,"type":"integer"},{"type":"null"}],"default":null,"title":"Font Weight"},"color":{"anyOf":[{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","type":"string"},{"type":"null"}],"default":null,"title":"Color"},"align":{"default":"center","enum":["left","center","right","justify"],"title":"Align","type":"string"},"line_height":{"anyOf":[{"exclusiveMinimum":0,"maximum":10,"type":"number"},{"type":"null"}],"default":null,"title":"Line Height"},"effects":{"anyOf":[{"$ref":"#/$defs/Effects"},{"type":"null"}],"default":null},"curve":{"anyOf":[{"maximum":400,"minimum":-400,"type":"number"},{"type":"null"}],"default":null,"description":"Bend the text into an arc: negative arches up, positive curves down, 0 = straight. Try ±150.","title":"Curve"}},"required":["op","text"],"title":"AddText","type":"object"},"ArrangeObject":{"additionalProperties":false,"description":"Move an object up or down the stack of its page.","properties":{"op":{"const":"arrange_object","title":"Op","type":"string"},"object_id":{"maxLength":64,"minLength":1,"title":"Object Id","type":"string"},"to":{"enum":["front","back","forward","backward"],"title":"To","type":"string"}},"required":["op","object_id","to"],"title":"ArrangeObject","type":"object"},"DeleteObjects":{"additionalProperties":false,"description":"Delete objects.","properties":{"op":{"const":"delete_objects","title":"Op","type":"string"},"object_ids":{"items":{"maxLength":64,"minLength":1,"type":"string"},"maxItems":500,"minItems":1,"title":"Object Ids","type":"array"}},"required":["op","object_ids"],"title":"DeleteObjects","type":"object"},"DeletePage":{"additionalProperties":false,"description":"Delete a page (a design always keeps at least one).","properties":{"op":{"const":"delete_page","title":"Op","type":"string"},"page":{"anyOf":[{"type":"string"},{"type":"integer"}],"title":"Page"}},"required":["op","page"],"title":"DeletePage","type":"object"},"Effects":{"additionalProperties":false,"description":"Text takes every effect; shapes only `shadow`. A glow replaces the shadow when both are set.","properties":{"shadow":{"anyOf":[{"$ref":"#/$defs/ShadowEffect"},{"type":"null"}],"default":null},"outline":{"anyOf":[{"$ref":"#/$defs/OutlineEffect"},{"type":"null"}],"default":null,"description":"A stroke around the letters."},"glow":{"anyOf":[{"$ref":"#/$defs/GlowEffect"},{"type":"null"}],"default":null},"highlight":{"anyOf":[{"$ref":"#/$defs/HighlightEffect"},{"type":"null"}],"default":null,"description":"A marker-style colour behind the text."}},"title":"Effects","type":"object"},"FieldTag":{"additionalProperties":false,"description":"A template field tag: `key` names the value, `type` what it holds, `label` is shown when filling.","properties":{"key":{"description":"1-40 characters: a-z, 0-9 and _, starting with a letter. Unique per page; the same key on several pages is the same value there.","pattern":"^[a-z][a-z0-9_]{0,39}$","title":"Key","type":"string"},"type":{"description":"text (text boxes), image (pictures, placeholders), color (shapes).","enum":["text","image","color"],"title":"Type","type":"string"},"label":{"anyOf":[{"maxLength":80,"type":"string"},{"type":"null"}],"default":null,"title":"Label"}},"required":["key","type"],"title":"FieldTag","type":"object"},"GlowEffect":{"additionalProperties":false,"properties":{"color":{"default":"#7a64e0","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"},"blur":{"default":18,"maximum":500,"minimum":0,"title":"Blur","type":"number"}},"title":"GlowEffect","type":"object"},"GradientStop":{"additionalProperties":false,"properties":{"offset":{"maximum":1,"minimum":0,"title":"Offset","type":"number"},"color":{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"}},"required":["offset","color"],"title":"GradientStop","type":"object"},"GroupObjects":{"additionalProperties":false,"description":"Group objects of one page so they move and scale together. The group takes the place of the lowest.","properties":{"op":{"const":"group_objects","title":"Op","type":"string"},"object_ids":{"items":{"maxLength":64,"minLength":1,"type":"string"},"maxItems":200,"minItems":2,"title":"Object Ids","type":"array"},"id":{"anyOf":[{"maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional id for the new group.","title":"Id"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"description":"Layer name.","title":"Name"}},"required":["op","object_ids"],"title":"GroupObjects","type":"object"},"HighlightEffect":{"additionalProperties":false,"properties":{"color":{"default":"#fde047","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"}},"title":"HighlightEffect","type":"object"},"MovePage":{"additionalProperties":false,"description":"Move a page to another position.","properties":{"op":{"const":"move_page","title":"Op","type":"string"},"page":{"anyOf":[{"type":"string"},{"type":"integer"}],"title":"Page"},"to_number":{"description":"New position, counting from 1.","minimum":1,"title":"To Number","type":"integer"}},"required":["op","page","to_number"],"title":"MovePage","type":"object"},"OutlineEffect":{"additionalProperties":false,"properties":{"color":{"default":"#000000","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"},"width":{"default":2,"exclusiveMinimum":0,"maximum":200,"title":"Width","type":"number"}},"title":"OutlineEffect","type":"object"},"RemoveBackground":{"additionalProperties":false,"description":"Remove the background of an image in the design, replacing it in place with a transparent cut-out.","properties":{"op":{"const":"remove_background","title":"Op","type":"string"},"object_id":{"maxLength":64,"minLength":1,"title":"Object Id","type":"string"},"model":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"A server model from list_ai_models; omitted: its `server_default`.","title":"Model"}},"required":["op","object_id"],"title":"RemoveBackground","type":"object"},"ReplaceImage":{"additionalProperties":false,"description":"Put a new picture into an existing image or photo placeholder, keeping its frame, crop shape, filters,\neffects and template field tag. The picture is scaled to cover the frame, centred on `focal`.","properties":{"op":{"const":"replace_image","title":"Op","type":"string"},"object_id":{"maxLength":64,"minLength":1,"title":"Object Id","type":"string"},"asset_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"From list_assets or import_stock_photo.","title":"Asset Id"},"element_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"From search_elements.","title":"Element Id"},"url":{"anyOf":[{"maxLength":2048,"minLength":8,"type":"string"},{"type":"null"}],"default":null,"description":"A public https link to an image (uploaded into your assets; needs `assets:write`).","title":"Url"},"focal":{"default":[0.5,0.5],"description":"Point of the picture to keep in the frame's centre, [x, y] from [0, 0] (top-left) to [1, 1] (bottom-right).","maxItems":2,"minItems":2,"prefixItems":[{"maximum":1,"minimum":0,"type":"number"},{"maximum":1,"minimum":0,"type":"number"}],"title":"Focal","type":"array"}},"required":["op","object_id"],"title":"ReplaceImage","type":"object"},"SetBackground":{"additionalProperties":false,"description":"Set a page background: a colour, a gradient or a picture (exactly one).","properties":{"op":{"const":"set_background","title":"Op","type":"string"},"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"color":{"anyOf":[{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","type":"string"},{"type":"null"}],"default":null,"title":"Color"},"gradient":{"anyOf":[{"items":{"$ref":"#/$defs/GradientStop"},"maxItems":10,"minItems":2,"type":"array"},{"type":"null"}],"default":null,"title":"Gradient"},"gradient_kind":{"default":"linear","enum":["linear","radial"],"title":"Gradient Kind","type":"string"},"gradient_angle":{"default":180,"maximum":360,"minimum":0,"title":"Gradient Angle","type":"number"},"asset_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"An upload to use as the background picture.","title":"Asset Id"},"fit":{"default":"cover","enum":["cover","contain","tile"],"title":"Fit","type":"string"}},"required":["op"],"title":"SetBackground","type":"object"},"SetNotes":{"additionalProperties":false,"description":"Set a page's speaker notes.","properties":{"op":{"const":"set_notes","title":"Op","type":"string"},"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"notes":{"maxLength":5000,"title":"Notes","type":"string"}},"required":["op","notes"],"title":"SetNotes","type":"object"},"ShadowEffect":{"additionalProperties":false,"properties":{"color":{"default":"#00000066","maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","title":"Color","type":"string"},"blur":{"default":12,"maximum":500,"minimum":0,"title":"Blur","type":"number"},"offset_x":{"default":4,"maximum":1000,"minimum":-1000,"title":"Offset X","type":"number"},"offset_y":{"default":6,"maximum":1000,"minimum":-1000,"title":"Offset Y","type":"number"}},"title":"ShadowEffect","type":"object"},"TextFit":{"additionalProperties":false,"description":"Shrink-to-fit text: the box height stays fixed while the font steps down to fit.","properties":{"mode":{"const":"shrink","default":"shrink","title":"Mode","type":"string"},"min_font_size":{"anyOf":[{"maximum":999,"minimum":4,"type":"number"},{"type":"null"}],"default":null,"description":"Smallest font size to shrink to (px). Default: half the font size.","title":"Min Font Size"}},"title":"TextFit","type":"object"},"Ungroup":{"additionalProperties":false,"description":"Break a group up: its objects go back on the page, where they appear, in its place in the stack.","properties":{"op":{"const":"ungroup","title":"Op","type":"string"},"object_id":{"maxLength":64,"minLength":1,"title":"Object Id","type":"string"}},"required":["op","object_id"],"title":"Ungroup","type":"object"},"UpdateObject":{"additionalProperties":false,"description":"Change an object. Only the fields you send change.","properties":{"op":{"const":"update_object","title":"Op","type":"string"},"object_id":{"maxLength":64,"minLength":1,"title":"Object Id","type":"string"},"x":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"description":"New top-left corner of the box (before rotation).","title":"X"},"y":{"anyOf":[{"maximum":100000,"minimum":-100000,"type":"number"},{"type":"null"}],"default":null,"title":"Y"},"width":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"description":"New box width; pictures keep their proportions.","title":"Width"},"height":{"anyOf":[{"exclusiveMinimum":0,"maximum":100000,"type":"number"},{"type":"null"}],"default":null,"description":"New box height (not for text: it follows the text).","title":"Height"},"angle":{"anyOf":[{"maximum":360,"minimum":-360,"type":"number"},{"type":"null"}],"default":null,"title":"Angle"},"opacity":{"anyOf":[{"maximum":1,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"title":"Opacity"},"text":{"anyOf":[{"maxLength":20000,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Text"},"color":{"anyOf":[{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","type":"string"},{"type":"null"}],"default":null,"description":"Text colour, shape fill or line colour.","title":"Color"},"stroke":{"anyOf":[{"maxLength":64,"pattern":"^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s]+\\)|[a-zA-Z]{3,30}|transparent)$","type":"string"},{"type":"null"}],"default":null,"title":"Stroke"},"stroke_width":{"anyOf":[{"maximum":1000,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"title":"Stroke Width"},"font_family":{"anyOf":[{"maxLength":120,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Font Family"},"font_size":{"anyOf":[{"exclusiveMinimum":0,"maximum":2000,"type":"number"},{"type":"null"}],"default":null,"title":"Font Size"},"font_weight":{"anyOf":[{"maximum":900,"minimum":100,"type":"integer"},{"type":"null"}],"default":null,"title":"Font Weight"},"align":{"anyOf":[{"enum":["left","center","right","justify"],"type":"string"},{"type":"null"}],"default":null,"title":"Align"},"effects":{"anyOf":[{"$ref":"#/$defs/Effects"},{"type":"null"}],"default":null,"description":"Replaces the object's effects; {} removes them. Shapes take only a shadow."},"curve":{"anyOf":[{"maximum":400,"minimum":-400,"type":"number"},{"type":"null"}],"default":null,"description":"Text only. Bend the text into an arc: negative arches up, positive curves down, 0 = straight. Try ±150.","title":"Curve"},"mask":{"anyOf":[{"enum":["circle","rounded","triangle","diamond","hexagon","star","heart","blob","arch","cross"],"type":"string"},{"const":"none","type":"string"},{"type":"null"}],"default":null,"description":"Crop the picture to a shape (uploaded pictures only). `none` removes it.","title":"Mask"},"mask_radius":{"anyOf":[{"maximum":0.5,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Corner radius of the `rounded` mask, as a fraction of the shorter side (default 0.18).","title":"Mask Radius"},"name":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"locked":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Locked"},"visible":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Visible"},"field":{"anyOf":[{"$ref":"#/$defs/FieldTag"},{"const":"none","type":"string"},{"type":"null"}],"default":null,"description":"Tag the object as a template field (text boxes: text, pictures and placeholders: image, shapes: color), so it can be found with list_fields and filled with data. `none` removes the tag.","title":"Field"},"fit":{"anyOf":[{"$ref":"#/$defs/TextFit"},{"const":"none","type":"string"},{"type":"null"}],"default":null,"description":"Text only. Shrink the font size down to `min_font_size` (default: half the font size) so the text fits inside the box's fixed height. `none` turns it off.","title":"Fit"},"props":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"description":"Advanced: raw document properties to set (Fabric.js names, e.g. {'charSpacing': 200}). Only these are accepted: backgroundColor, charSpacing, flipX, flipY, fontStyle, lineHeight, linethrough, overline, rx, ry, skewX, skewY, strokeDashArray, strokeDashOffset, strokeLineCap, strokeLineJoin, strokeUniform, textBackgroundColor, underline. A null value removes the property.","title":"Props"}},"required":["op","object_id"],"title":"UpdateObject","type":"object"}},"title":"edit_designArguments"},"name":"edit_design","outputSchema":{"type":"object","additionalProperties":true,"title":"edit_designDictOutput"},"title":"Edit a design"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Fill template fields"},"description":"Fill a template's fields by key in one step: every object tagged with a key gets its value (a key on\n    several pages fills each of them). All or nothing: an unknown key or a wrong value is an error naming the\n    key and nothing is changed. Image links are uploaded into your assets first (needs `assets:write`).\n    Returns the design id, the keys filled and skipped, and `overflow`: shrink-to-fit texts still too long.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"values":{"additionalProperties":true,"description":"{field key: value} (keys from list_fields). text: a string; color: '#hex'; image: {asset_id} | {element_id} | {url} with an optional focal [x, y], or a https link or an upload's name as a string. A blank value leaves the field as it is.","title":"Values","type":"object"},"as_copy":{"default":true,"description":"Fill a new copy and leave the template as it is (default); false edits it.","title":"As Copy","type":"boolean"},"name":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"description":"Title of the filled design.","title":"Name"}},"required":["design_id","values"],"type":"object","title":"fill_designArguments"},"name":"fill_design","outputSchema":{"type":"object","additionalProperties":true,"title":"fill_designDictOutput"},"title":"Fill template fields"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Bulk create from a template"},"description":"Make one new design per row from a template, filled like fill_design. Each row reports its new design\n    or its own error, so one bad row doesn't stop the others. Each row counts as one call against the rate\n    limit; the number of rows per call is limited by the server.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"rows":{"description":"One {field key: value} object per new design (values as in fill_design).","items":{"additionalProperties":true,"type":"object"},"minItems":1,"title":"Rows","type":"array"},"name_pattern":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"description":"Title of each new design: {title} (the template's), {n} (the row number) and {key} (a text value of the row). Default: '{title} - {n}'.","title":"Name Pattern"},"folder_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Put the new designs in this folder.","title":"Folder Id"},"export":{"anyOf":[{"enum":["png","jpg"],"type":"string"},{"type":"null"}],"default":null,"description":"Also return the first page of each as an image.","title":"Export"}},"required":["design_id","rows"],"type":"object","title":"bulk_fillArguments"},"name":"bulk_fill","title":"Bulk create from a template"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List AI models"},"description":"The AI models you can pick for a task. 'device' models run in the user's browser and cannot be used\n    here; tools use a 'server' one. `sends_offsite: true` means the image leaves this installation: tell the\n    user before using it. `server_default` is what tools use when no `model` is given (null: pass one).","inputSchema":{"properties":{"task":{"default":"background-removal","description":"The AI task, e.g. 'background-removal'.","title":"Task","type":"string"}},"type":"object","title":"list_ai_modelsArguments"},"name":"list_ai_models","outputSchema":{"type":"object","additionalProperties":true,"title":"list_ai_modelsDictOutput"},"title":"List AI models"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Remove background from an upload"},"description":"Remove the background of a picture in your uploads; the transparent cut-out is saved as a new upload\n    and returned, with the `model` used.","inputSchema":{"properties":{"asset_id":{"description":"A picture's id from list_assets or import_stock_photo.","title":"Asset Id","type":"string"},"model":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"A server model from list_ai_models; omitted: `server_default`.","title":"Model"}},"required":["asset_id"],"type":"object","title":"remove_asset_backgroundArguments"},"name":"remove_asset_background","outputSchema":{"type":"object","additionalProperties":true,"title":"remove_asset_backgroundDictOutput"},"title":"Remove background from an upload"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List brand kits"},"description":"Your brand kits: named colours, font roles and logos (logo ids work as asset_id in add_image).","inputSchema":{"properties":{},"type":"object","title":"list_brand_kitsArguments"},"name":"list_brand_kits","outputSchema":{"type":"object","additionalProperties":true,"title":"list_brand_kitsDictOutput"},"title":"List brand kits"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create a brand kit"},"description":"Create a brand kit. The default kit is the one the editor offers first.","inputSchema":{"properties":{"name":{"maxLength":80,"minLength":1,"title":"Name","type":"string"},"colors":{"anyOf":[{"items":{"$ref":"#/$defs/BrandColor"},"maxItems":100,"type":"array"},{"type":"null"}],"default":null,"description":"Replaces the kit's colours.","title":"Colors"},"fonts":{"anyOf":[{"items":{"$ref":"#/$defs/BrandFont"},"maxItems":3,"type":"array"},{"type":"null"}],"default":null,"description":"Replaces the kit's fonts.","title":"Fonts"},"logo_ids":{"anyOf":[{"items":{"type":"string"},"maxItems":20,"type":"array"},{"type":"null"}],"default":null,"description":"Replaces the logos: asset ids from list_assets.","title":"Logo Ids"},"is_default":{"default":false,"title":"Is Default","type":"boolean"}},"required":["name"],"type":"object","$defs":{"BrandColor":{"properties":{"hex":{"description":"#rgb or #rrggbb.","maxLength":7,"title":"Hex","type":"string"},"name":{"default":"","maxLength":40,"title":"Name","type":"string"}},"required":["hex"],"title":"BrandColor","type":"object"},"BrandFont":{"properties":{"role":{"enum":["heading","subheading","body"],"title":"Role","type":"string"},"family":{"description":"A family from search_fonts.","maxLength":100,"title":"Family","type":"string"}},"required":["role","family"],"title":"BrandFont","type":"object"}},"title":"create_brand_kitArguments"},"name":"create_brand_kit","outputSchema":{"type":"object","additionalProperties":true,"title":"create_brand_kitDictOutput"},"title":"Create a brand kit"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Change a brand kit"},"description":"Change a brand kit. Only what you pass changes; colours, fonts and logos are replaced as a whole.","inputSchema":{"properties":{"kit_id":{"description":"A brand kit id from list_brand_kits.","title":"Kit Id","type":"string"},"name":{"anyOf":[{"maxLength":80,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"colors":{"anyOf":[{"items":{"$ref":"#/$defs/BrandColor"},"maxItems":100,"type":"array"},{"type":"null"}],"default":null,"description":"Replaces the kit's colours.","title":"Colors"},"fonts":{"anyOf":[{"items":{"$ref":"#/$defs/BrandFont"},"maxItems":3,"type":"array"},{"type":"null"}],"default":null,"description":"Replaces the kit's fonts.","title":"Fonts"},"logo_ids":{"anyOf":[{"items":{"type":"string"},"maxItems":20,"type":"array"},{"type":"null"}],"default":null,"description":"Replaces the logos: asset ids from list_assets.","title":"Logo Ids"},"is_default":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Is Default"}},"required":["kit_id"],"type":"object","$defs":{"BrandColor":{"properties":{"hex":{"description":"#rgb or #rrggbb.","maxLength":7,"title":"Hex","type":"string"},"name":{"default":"","maxLength":40,"title":"Name","type":"string"}},"required":["hex"],"title":"BrandColor","type":"object"},"BrandFont":{"properties":{"role":{"enum":["heading","subheading","body"],"title":"Role","type":"string"},"family":{"description":"A family from search_fonts.","maxLength":100,"title":"Family","type":"string"}},"required":["role","family"],"title":"BrandFont","type":"object"}},"title":"update_brand_kitArguments"},"name":"update_brand_kit","outputSchema":{"type":"object","additionalProperties":true,"title":"update_brand_kitDictOutput"},"title":"Change a brand kit"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List templates"},"description":"Find templates to start a design from (create_design with `template` = the slug).","inputSchema":{"properties":{"query":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"description":"Words in the title, description or tags.","title":"Query"},"category":{"anyOf":[{"maxLength":60,"type":"string"},{"type":"null"}],"default":null,"description":"A category slug.","title":"Category"},"orientation":{"anyOf":[{"enum":["square","portrait","landscape"],"type":"string"},{"type":"null"}],"default":null,"title":"Orientation"},"limit":{"default":20,"maximum":50,"minimum":1,"title":"Limit","type":"integer"}},"type":"object","title":"list_templatesArguments"},"name":"list_templates","outputSchema":{"type":"object","additionalProperties":true,"title":"list_templatesDictOutput"},"title":"List templates"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search elements"},"description":"Search the graphics catalogue (icons, illustrations, stickers, shapes…). Add one to a design with\n    edit_design: {\"op\": \"add_image\", \"element_id\": …}.","inputSchema":{"properties":{"query":{"description":"e.g. 'arrow', 'leaf', 'star'.","maxLength":100,"minLength":1,"title":"Query","type":"string"},"kind":{"anyOf":[{"enum":["icon","illustration","sticker","shape","line","frame","graphic"],"type":"string"},{"type":"null"}],"default":null,"title":"Kind"},"limit":{"default":20,"maximum":50,"minimum":1,"title":"Limit","type":"integer"}},"required":["query"],"type":"object","title":"search_elementsArguments"},"name":"search_elements","outputSchema":{"type":"object","additionalProperties":true,"title":"search_elementsDictOutput"},"title":"Search elements"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search fonts"},"description":"Search the font catalogue, most popular first. Use a `family` as `font_family` in edit_design.","inputSchema":{"properties":{"query":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"title":"Query"},"category":{"anyOf":[{"enum":["sans-serif","serif","display","handwriting","monospace"],"type":"string"},{"type":"null"}],"default":null,"title":"Category"},"limit":{"default":20,"maximum":50,"minimum":1,"title":"Limit","type":"integer"}},"type":"object","title":"search_fontsArguments"},"name":"search_fonts","outputSchema":{"type":"object","additionalProperties":true,"title":"search_fontsDictOutput"},"title":"Search fonts"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List comments"},"description":"Comments on a design, oldest first. A comment with x, y is pinned to that point of its page.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"include_resolved":{"default":false,"title":"Include Resolved","type":"boolean"},"limit":{"default":100,"maximum":200,"minimum":1,"title":"Limit","type":"integer"}},"required":["design_id"],"type":"object","title":"list_commentsArguments"},"name":"list_comments","outputSchema":{"type":"object","additionalProperties":true,"title":"list_commentsDictOutput"},"title":"List comments"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Add a comment"},"description":"Comment on a design, optionally pinned to a point (x, y) of a page, or reply to a comment.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"body":{"maxLength":2000,"minLength":1,"title":"Body","type":"string"},"page_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Pin to this page (with x and y).","title":"Page Id"},"x":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"X"},"y":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Y"},"reply_to":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Answer this comment instead.","title":"Reply To"}},"required":["design_id","body"],"type":"object","title":"add_commentArguments"},"name":"add_comment","outputSchema":{"type":"object","additionalProperties":true,"title":"add_commentDictOutput"},"title":"Add a comment"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Resolve a comment"},"description":"Mark a comment thread as resolved (or re-open it with resolved = false). Replies cannot be resolved\n    on their own; resolve the comment they answer.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"comment_id":{"description":"A comment id from list_comments.","title":"Comment Id","type":"string"},"resolved":{"default":true,"title":"Resolved","type":"boolean"}},"required":["design_id","comment_id"],"type":"object","title":"resolve_commentArguments"},"name":"resolve_comment","outputSchema":{"type":"object","additionalProperties":true,"title":"resolve_commentDictOutput"},"title":"Resolve a comment"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Edit a comment"},"description":"Change the text of a comment you wrote (comments by other people can be resolved, not rewritten).","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"comment_id":{"description":"A comment id from list_comments.","title":"Comment Id","type":"string"},"body":{"maxLength":2000,"minLength":1,"title":"Body","type":"string"}},"required":["design_id","comment_id","body"],"type":"object","title":"edit_commentArguments"},"name":"edit_comment","outputSchema":{"type":"object","additionalProperties":true,"title":"edit_commentDictOutput"},"title":"Edit a comment"},{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Delete a comment"},"description":"Delete a comment, with its replies. This cannot be undone; prefer resolve_comment for finished\n    threads.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"comment_id":{"description":"A comment id from list_comments.","title":"Comment Id","type":"string"}},"required":["design_id","comment_id"],"type":"object","title":"delete_commentArguments"},"name":"delete_comment","outputSchema":{"type":"object","additionalProperties":true,"title":"delete_commentDictOutput"},"title":"Delete a comment"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Export a design as an image"},"description":"Render one page of a design as an image, exactly as the editor draws it, to check how it looks\n    (after edit_design, for example). It shows the live state when the design is open in the editor.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"page":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"null"}],"default":null,"description":"The page: its id, or its number counting from 1. Defaults to the first page.","title":"Page"},"format":{"default":"png","enum":["png","jpg","webp"],"title":"Format","type":"string"},"quality":{"default":90,"description":"JPG and WebP only.","maximum":100,"minimum":1,"title":"Quality","type":"integer"},"scale":{"default":1.0,"description":"Output pixels per page pixel; below 1 for a quick look.","maximum":4,"minimum":0.1,"title":"Scale","type":"number"},"transparent":{"default":false,"description":"Leave the page background out (not for JPG).","title":"Transparent","type":"boolean"},"delivery":{"default":"inline","description":"inline: the image itself, to look at. url: a download link that expires after a few minutes, for large images or to hand on. Images too large to send inline become a link.","enum":["inline","url"],"title":"Delivery","type":"string"}},"required":["design_id"],"type":"object","title":"export_designArguments"},"name":"export_design","title":"Export a design as an image"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List versions"},"description":"A design's saved versions, newest first (automatic snapshots and named ones).","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"limit":{"default":20,"maximum":100,"minimum":1,"title":"Limit","type":"integer"}},"required":["design_id"],"type":"object","title":"list_versionsArguments"},"name":"list_versions","outputSchema":{"type":"object","additionalProperties":true,"title":"list_versionsDictOutput"},"title":"List versions"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Restore a version"},"description":"Put a design back to a saved version (the current state is kept as a version first, so this can be\n    undone too). Anyone with the design open sees it replaced.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"version_id":{"description":"From list_versions.","title":"Version Id","type":"string"}},"required":["design_id","version_id"],"type":"object","title":"restore_versionArguments"},"name":"restore_version","outputSchema":{"type":"object","additionalProperties":true,"title":"restore_versionDictOutput"},"title":"Restore a version"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List folders"},"description":"Your folders, by name. A folder with a parent_id is inside that folder.","inputSchema":{"properties":{},"type":"object","title":"list_foldersArguments"},"name":"list_folders","outputSchema":{"type":"object","additionalProperties":true,"title":"list_foldersDictOutput"},"title":"List folders"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create a folder"},"description":"Create a folder, at the top level or inside another folder.","inputSchema":{"properties":{"name":{"maxLength":120,"minLength":1,"title":"Name","type":"string"},"parent_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"A folder from list_folders; none = top level.","title":"Parent Id"}},"required":["name"],"type":"object","title":"create_folderArguments"},"name":"create_folder","outputSchema":{"type":"object","additionalProperties":true,"title":"create_folderDictOutput"},"title":"Create a folder"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Rename a folder"},"description":"Change a folder's name.","inputSchema":{"properties":{"folder_id":{"description":"A folder id from list_folders.","title":"Folder Id","type":"string"},"name":{"maxLength":120,"minLength":1,"title":"Name","type":"string"}},"required":["folder_id","name"],"type":"object","title":"rename_folderArguments"},"name":"rename_folder","outputSchema":{"type":"object","additionalProperties":true,"title":"rename_folderDictOutput"},"title":"Rename a folder"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Move a folder"},"description":"Put a folder inside another folder, or back at the top level.","inputSchema":{"properties":{"folder_id":{"description":"A folder id from list_folders.","title":"Folder Id","type":"string"},"parent_id":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"A folder from list_folders; none = top level.","title":"Parent Id"}},"required":["folder_id","parent_id"],"type":"object","title":"move_folderArguments"},"name":"move_folder","outputSchema":{"type":"object","additionalProperties":true,"title":"move_folderDictOutput"},"title":"Move a folder"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Delete a folder"},"description":"Delete a folder. Nothing in it is deleted: its designs and subfolders move up to its parent.","inputSchema":{"properties":{"folder_id":{"description":"A folder id from list_folders.","title":"Folder Id","type":"string"}},"required":["folder_id"],"type":"object","title":"delete_folderArguments"},"name":"delete_folder","outputSchema":{"type":"object","additionalProperties":true,"title":"delete_folderDictOutput"},"title":"Delete a folder"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Move a design to a folder"},"description":"Put a design in a folder, or back at the top level.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"folder_id":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"A folder from list_folders; none = top level.","title":"Folder Id"}},"required":["design_id","folder_id"],"type":"object","title":"move_designArguments"},"name":"move_design","outputSchema":{"type":"object","additionalProperties":true,"title":"move_designDictOutput"},"title":"Move a design to a folder"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Star a design"},"description":"Star a design (or unstar it with starred = false); list_designs can filter on stars.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"starred":{"default":true,"title":"Starred","type":"boolean"}},"required":["design_id"],"type":"object","title":"star_designArguments"},"name":"star_design","outputSchema":{"type":"object","additionalProperties":true,"title":"star_designDictOutput"},"title":"Star a design"},{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Move a design to the trash"},"description":"Move a design to the trash. It can be brought back with restore_design until the trash is emptied.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"}},"required":["design_id"],"type":"object","title":"trash_designArguments"},"name":"trash_design","outputSchema":{"type":"object","additionalProperties":true,"title":"trash_designDictOutput"},"title":"Move a design to the trash"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Restore a design from the trash"},"description":"Bring a trashed design back.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs(in_trash=true).","title":"Design Id","type":"string"}},"required":["design_id"],"type":"object","title":"restore_designArguments"},"name":"restore_design","outputSchema":{"type":"object","additionalProperties":true,"title":"restore_designDictOutput"},"title":"Restore a design from the trash"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List share links"},"description":"A design's share links, newest first, with their URL, role and whether they still work.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"}},"required":["design_id"],"type":"object","title":"list_share_linksArguments"},"name":"list_share_links","outputSchema":{"type":"object","additionalProperties":true,"title":"list_share_linksDictOutput"},"title":"List share links"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create a share link"},"description":"Create a link that lets anyone who has it view, comment on or edit the design (no account needed).\n    Prefer `view` unless the user asked for more.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"role":{"default":"view","description":"What people with the link may do.","enum":["view","comment","edit"],"title":"Role","type":"string"},"expires_at":{"anyOf":[{"format":"date-time","type":"string"},{"type":"null"}],"default":null,"description":"When the link stops working (ISO 8601). Default: never.","title":"Expires At"},"password":{"anyOf":[{"maxLength":128,"type":"string"},{"type":"null"}],"default":null,"description":"Ask visitors for this password (printable ASCII).","title":"Password"}},"required":["design_id"],"type":"object","title":"create_share_linkArguments"},"name":"create_share_link","outputSchema":{"type":"object","additionalProperties":true,"title":"create_share_linkDictOutput"},"title":"Create a share link"},{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Change a share link"},"description":"Change a share link. Only what you pass changes.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"link_id":{"description":"A share link id from list_share_links.","title":"Link Id","type":"string"},"role":{"anyOf":[{"enum":["view","comment","edit"],"type":"string"},{"type":"null"}],"default":null,"title":"Role"},"active":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"description":"false pauses the link; true turns it back on.","title":"Active"},"expires_at":{"anyOf":[{"format":"date-time","type":"string"},{"const":"never","type":"string"},{"type":"null"}],"default":null,"description":"A new expiry (ISO 8601), or \"never\" to remove it.","title":"Expires At"},"password":{"anyOf":[{"maxLength":128,"type":"string"},{"type":"null"}],"default":null,"description":"A new password; \"\" removes it.","title":"Password"}},"required":["design_id","link_id"],"type":"object","title":"update_share_linkArguments"},"name":"update_share_link","outputSchema":{"type":"object","additionalProperties":true,"title":"update_share_linkDictOutput"},"title":"Change a share link"},{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Revoke a share link"},"description":"Delete a share link: it stops working at once for everyone who has it.","inputSchema":{"properties":{"design_id":{"description":"A design id from list_designs.","title":"Design Id","type":"string"},"link_id":{"description":"A share link id from list_share_links.","title":"Link Id","type":"string"}},"required":["design_id","link_id"],"type":"object","title":"revoke_share_linkArguments"},"name":"revoke_share_link","outputSchema":{"type":"object","additionalProperties":true,"title":"revoke_share_linkDictOutput"},"title":"Revoke a share link"}]}}