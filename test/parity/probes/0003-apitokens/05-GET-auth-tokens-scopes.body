[{"id":"designs:read","description":"See your designs, their versions and comments, and browse templates, elements and fonts."},{"id":"designs:write","description":"Create, edit, rename, duplicate and organise your designs, and restore earlier versions."},{"id":"designs:trash","description":"Move your designs to the trash and restore them."},{"id":"assets:write","description":"Add images to your uploads (stock photos, images from a URL, AI background removal)."},{"id":"comments:write","description":"Add comments to your designs."},{"id":"comments:manage","description":"Edit your own comments, and resolve and delete comments on your designs (anyone's)."},{"id":"brand:write","description":"Create and change your brand kits."},{"id":"sharing:write","description":"See, create and revoke share links to your designs (they let other people in)."}]