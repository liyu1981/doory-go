      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/elements/:
    get:
      operationId: elements_list
      description: 'Catalog reads are identical for everyone: no session lookup, and
        shared caches may keep them.'
      parameters:
      - in: query
        name: kind
        schema:
          type: string
          enum:
          - frame
          - graphic
          - icon
          - illustration
          - line
          - shape
          - sticker
        description: |-
          * `shape` - Shape
          * `line` - Line
          * `icon` - Icon
          * `sticker` - Sticker
          * `illustration` - Illustration
          * `frame` - Frame
          * `graphic` - Graphic
      - in: query
        name: ordering
        schema:
          type: string
          enum:
          - -created_at
          - -name
          - -sort_order
          - created_at
          - name
          - relevance
          - sort_order
        description: |-
          * `name` - name
          * `-name` - -name
          * `created_at` - created_at
          * `-created_at` - -created_at
          * `sort_order` - sort_order
          * `-sort_order` - -sort_order
          * `relevance` - relevance
      - in: query
        name: pack
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: q
        schema:
          type: string
      - in: query
        name: style
        schema:
          type: string
          enum:
          - colour
          - duotone
          - filled
          - outline
        description: |-
          * `outline` - Outline
          * `filled` - Filled
          * `duotone` - Duotone
          * `colour` - Colour
      tags:
      - elements
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedElementItemList'
          description: ''
  /api/v1/elements/packs/:
    get:
      operationId: elements_packs_list
      description: Packs that contain at least one published element (not paginated).
      tags:
      - elements
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ElementPack'
          description: ''
  /api/v1/exports/pdf/:
    post:
      operationId: exports_pdf_create
      description: Print the editor's SVG pages to a PDF with headless Chromium.
      tags:
      - exports
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PdfExportDocumentationRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/pdf:
              schema:
                type: string
                format: binary
          description: ''
