  /api/v1/folders/{id}/:
    get:
      operationId: folders_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - folders
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Folder'
          description: ''
    patch:
      operationId: folders_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - folders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedFolderWriteRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Folder'
          description: ''
    delete:
      operationId: folders_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - folders
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/fonts/:
    get:
      operationId: fonts_list
      description: |-
        Built-in fonts that have at least one file. Identical for everyone, so no session lookup and
        shared caches may keep it.
      parameters:
      - in: query
        name: category
        schema:
          type: string
          enum:
          - display
          - handwriting
          - monospace
          - sans-serif
          - serif
        description: |-
          * `sans-serif` - Sans serif
          * `serif` - Serif
          * `display` - Display
          * `handwriting` - Handwriting
          * `monospace` - Monospace
      - in: query
        name: ordering
        schema:
          type: array
          items:
            type: string
            enum:
            - -created_at
            - -family
            - -popularity
            - created_at
            - family
            - popularity
        description: |-
          Ordering

          * `popularity` - Popularity
          * `-popularity` - Popularity (descending)
          * `family` - Family
          * `-family` - Family (descending)
          * `created_at` - Created at
          * `-created_at` - Created at (descending)
        explode: false
        style: form
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: q
        schema:
          type: string
      - in: query
        name: script
        schema:
          type: string
      tags:
      - fonts
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedFontFamilyList'
          description: ''
  /api/v1/fonts/mine/:
    get:
      operationId: fonts_mine_list
      description: The caller's uploaded font families (list) and uploading new ones
        (multipart `files`).
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - fonts
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedFontFamilyList'
          description: ''
    post:
      operationId: fonts_mine_create
      description: The caller's uploaded font families (list) and uploading new ones
        (multipart `files`).
      tags:
      - fonts
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FontUploadRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/FontUploadRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FontFamily'
          description: ''
  /api/v1/fonts/mine/{id}/:
    delete:
      operationId: fonts_mine_destroy
      description: Remove one of the caller's uploaded families and its files. Other
        users' fonts are a 404.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - fonts
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/health/:
    get:
      operationId: health_retrieve
      tags:
      - system
      security:
      - {}
      responses:
        '200':
          description: Liveness and database check.
  /api/v1/shared/{token}/:
    get:
      operationId: shared_retrieve
      description: 'Base for `/shared/{token}/...`: link lookup, password gate and
        no-store headers.'
      parameters:
      - in: header
        name: X-Share-Password
        schema:
          type: string
        description: Password of the link, when it has one.
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - sharing
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SharedDesign'
          description: ''
    patch:
      operationId: shared_partial_update
      description: Save through an `edit` link (optimistic concurrency on `base_revision`).
      parameters:
      - in: header
        name: X-Share-Password
        schema:
          type: string
        description: Password of the link, when it has one.
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - sharing
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedSharedSaveRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SharedSaveResult'
          description: ''
  /api/v1/shared/{token}/comments/:
    get:
      operationId: shared_comments_list
      description: Applies the `upload` rate (on top of the default throttles) to
        the listed methods only.
      parameters:
      - in: header
        name: X-Share-Password
        schema:
          type: string
        description: Password of the link, when it has one.
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - comments
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCommentList'
          description: ''
    post:
      operationId: shared_comments_create
      description: Applies the `upload` rate (on top of the default throttles) to
        the listed methods only.
      parameters:
      - in: header
        name: X-Share-Password
        schema:
          type: string
        description: Password of the link, when it has one.
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - comments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CommentCreateRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Comment'
          description: ''
  /api/v1/shared/{token}/comments/{id}/:
    patch:
      operationId: shared_comments_partial_update
      description: Authors move the pin of their own thread through a `comment` or
        `edit` link.
      parameters:
      - in: header
        name: X-Share-Password
        schema:
          type: string
        description: Password of the link, when it has one.
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - comments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedCommentMoveRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Comment'
          description: ''
    delete:
      operationId: shared_comments_destroy
      description: Authors can remove their own comments through any valid link of
        the design.
      parameters:
      - in: header
        name: X-Share-Password
        schema:
          type: string
        description: Password of the link, when it has one.
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - comments
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/size-presets/:
    get:
      operationId: size_presets_retrieve
      description: Public size preset catalogue (built-in and configured), nested
        in groups.
      tags:
      - system
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: 'The size preset catalogue: `{version, groups: [{slug, label,
            icon, children: [...], presets: [{slug, label, width, height, unit, width_px,
            height_px, icon, tags, is_quick, aliases, meta}]}]}`. `width` and `height`
            are in `unit`; `width_px` and `height_px` are whole pixels at 96 dpi.'
  /api/v1/stock/audio/:
    get:
      operationId: stock_audio_retrieve
      parameters:
      - in: query
        name: length
        schema:
          enum:
          - any
          - short
          - medium
          - long
          - extended
          type: string
          minLength: 1
        description: |-
          * `any` - any
          * `short` - short
          * `medium` - medium
          * `long` - long
          * `extended` - extended
      - in: query
        name: page
        schema:
          type: integer
          maximum: 100
          minimum: 1
      - in: query
        name: per_page
        schema:
          type: integer
          maximum: 30
          minimum: 1
      - in: query
        name: q
        schema:
          type: string
          maxLength: 100
      - in: query
        name: sort
        schema:
          enum:
          - relevance
          - rating
          - downloads
          - newest
          - shortest
          type: string
          minLength: 1
        description: |-
          * `relevance` - relevance
          * `rating` - rating
          * `downloads` - downloads
          * `newest` - newest
          * `shortest` - shortest
      - in: query
        name: subcategory
        schema:
          type: string
          maxLength: 60
      - in: query
        name: type
        schema:
          enum:
          - all
          - music
          - effects
          - ambience
          type: string
          minLength: 1
        description: |-
          * `all` - all
          * `music` - music
          * `effects` - effects
          * `ambience` - ambience
      tags:
      - stock
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/stock/audio/{sound_id}/preview/:
    get:
      operationId: stock_audio_preview_retrieve
      description: The sound's short MP3 preview, relayed from Freesound's CDN.
      parameters:
      - in: path
        name: sound_id
        schema:
          type: string
        required: true
      tags:
      - stock
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            audio/mpeg:
              schema:
                type: string
                format: binary
          description: ''
  /api/v1/stock/audio/import/:
    post:
      operationId: stock_audio_import_create
      tags:
      - stock
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AudioImportRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AudioImportRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AudioImportRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
        '201':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/stock/audio/info/:
    get:
      operationId: stock_audio_info_retrieve
      tags:
      - stock
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/stock/photos/:
    get:
      operationId: stock_photos_retrieve
      parameters:
      - in: query
        name: cursor
        schema:
          type: string
          minLength: 1
          maxLength: 300
        description: '`next_page` of an `all` search.'
      - in: query
        name: lang
        schema:
          type: string
          minLength: 1
          maxLength: 35
          pattern: ^[A-Za-z]{2}([-_][A-Za-z0-9]{1,8})*$
      - in: query
        name: page
        schema:
          type: integer
          maximum: 100
          minimum: 1
      - in: query
        name: per_page
        schema:
          type: integer
          maximum: 30
          minimum: 1
      - in: query
        name: provider
        schema:
          enum:
          - unsplash
          - pexels
          - pixabay
          - all
          type: string
          minLength: 1
        description: |-
          * `unsplash` - unsplash
          * `pexels` - pexels
          * `pixabay` - pixabay
          * `all` - all
      - in: query
        name: q
        schema:
          type: string
          maxLength: 100
      tags:
      - stock
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/stock/photos/import/:
    post:
      operationId: stock_photos_import_create
      tags:
      - stock
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/StockImportRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/StockImportRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/StockImportRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
  /api/v1/stock/providers/:
    get:
      operationId: stock_providers_retrieve
      description: The configured providers in tab order, with the credit each one
        asks for, and the default tab.
      tags:
      - stock
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/template-categories/:
    get:
      operationId: template_categories_list
      description: All template categories with the number of published templates
        in each (not paginated).
      tags:
      - template-categories
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TemplateCategory'
          description: ''
  /api/v1/templates/:
    get:
      operationId: templates_list
      description: Published templates; `document` is not loaded for list rows.
      parameters:
      - in: query
        name: category
        schema:
          type: string
      - in: query
        name: featured
        schema:
          type: boolean
      - in: query
        name: ordering
        schema:
          type: array
          items:
            type: string
            enum:
            - -created_at
            - -title
            - -use_count
            - created_at
            - title
            - use_count
        description: |-
          Ordering

          * `use_count` - Use count
          * `-use_count` - Use count (descending)
          * `created_at` - Created at
          * `-created_at` - Created at (descending)
          * `title` - Title
          * `-title` - Title (descending)
        explode: false
        style: form
      - in: query
        name: orientation
        schema:
          type: string
          enum:
          - landscape
          - portrait
          - square
        description: |-
          * `landscape` - Landscape
          * `portrait` - Portrait
          * `square` - Square
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: preset
        schema:
          type: string
      - in: query
        name: q
        schema:
          type: string
      tags:
      - templates
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedTemplateSummaryList'
          description: ''
  /api/v1/templates/{slug}/:
    get:
      operationId: templates_retrieve
      description: 'Gallery reads are identical for everyone: no session lookup (so
        responses stay cacheable).'
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - templates
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TemplateDetail'
          description: ''
  /api/v1/templates/{slug}/use/:
    post:
      operationId: templates_use_create
      description: Create a design owned by the caller from a template (shortcut for
        `POST /designs/ {template}`).
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - templates
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
components:
  schemas:
    ActionEnum:
      enum:
      - trash
      - restore
      - delete
      - star
      - unstar
      - move
      type: string
      description: |-
        * `trash` - trash
        * `restore` - restore
        * `delete` - delete
        * `star` - star
        * `unstar` - unstar
        * `move` - move
    ApiToken:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          readOnly: true
        prefix:
          type: string
          readOnly: true
        scopes:
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        last_used_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        expires_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        revoked_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
      required:
      - created_at
      - expires_at
      - id
      - last_used_at
      - name
      - prefix
      - revoked_at
      - scopes
    ApiTokenCreateRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 160
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/ScopesEnum'
          default:
          - designs:read
          - designs:write
          maxItems: 8
          minItems: 1
        expires_in_days:
          type: integer
          maximum: 365
          minimum: 1
          default: 90
        password:
          type: string
          writeOnly: true
          maxLength: 128
        confirm_email:
          type: string
          writeOnly: true
          maxLength: 254
      required:
      - name
    AppConfig:
      type: object
      properties:
        google_client_id:
          type: string
        features:
          $ref: '#/components/schemas/AppConfigFeatures'
        exports:
          $ref: '#/components/schemas/AppConfigExports'
        limits:
          $ref: '#/components/schemas/AppConfigLimits'
        assets:
          $ref: '#/components/schemas/AppConfigAssets'
        ai:
          $ref: '#/components/schemas/AppConfigAI'
      required:
      - ai
      - assets
      - exports
      - features
      - google_client_id
      - limits
    AppConfigAI:
      type: object
      properties:
        user_providers:
          $ref: '#/components/schemas/UserProvidersEnum'
        offsite_notice:
          type: string
          description: 'The operator''s wording of the notice under options that send
            the image off this installation; empty: the editor''s own.'
        background_removal:
          allOf:
          - $ref: '#/components/schemas/TaskOptions'
          description: The options every signed-in user has; GET /api/v1/ai/models/
            lists those of the signed-in user.
      required:
      - background_removal
      - offsite_notice
      - user_providers
    AppConfigAssets:
      type: object
      properties:
        background_removal_model:
          allOf:
          - $ref: '#/components/schemas/BackgroundRemovalModel'
          nullable: true
      required:
      - background_removal_model
    AppConfigExports:
      type: object
      properties:
        filename_style:
          $ref: '#/components/schemas/FilenameStyleEnum'
        filename_timestamp:
          type: boolean
      required:
      - filename_style
      - filename_timestamp
    AppConfigFeatures:
      type: object
      properties:
        stock_photos:
          type: boolean
        server_pdf:
          type: boolean
        google_login:
          type: boolean
        email_verification:
          type: boolean
        background_removal:
          type: boolean
        realtime:
          type: boolean
        mcp:
          type: boolean
        ai_providers:
          type: boolean
      required:
      - ai_providers
      - background_removal
      - email_verification
      - google_login
      - mcp
      - realtime
      - server_pdf
      - stock_photos
    AppConfigLimits:
      type: object
      properties:
        max_upload_bytes:
          type: integer
        max_pages:
          type: integer
        max_document_bytes:
          type: integer
        realtime_max_participants:
          type: integer
        bulk_fill_max_rows:
          type: integer
      required:
      - bulk_fill_max_rows
      - max_document_bytes
      - max_pages
      - max_upload_bytes
      - realtime_max_participants
    Asset:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        kind:
          allOf:
          - $ref: '#/components/schemas/AssetKindEnum'
          readOnly: true
        name:
          type: string
          readOnly: true
        url:
          type: string
          readOnly: true
        thumb_url:
          type: string
          readOnly: true
        width:
          type: integer
          readOnly: true
        height:
          type: integer
          readOnly: true
        size:
          type: integer
          readOnly: true
        mime:
          type: string
          readOnly: true
        tags:
          readOnly: true
        attribution:
          type: object
          additionalProperties: {}
          nullable: true
          readOnly: true
        duration_ms:
          type: integer
          nullable: true
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - attribution
      - created_at
      - duration_ms
      - height
      - id
      - kind
      - mime
      - name
      - size
      - tags
      - thumb_url
      - url
      - width
    AssetKindEnum:
      enum:
      - image
      - svg
      - audio
      type: string
      description: |-
        * `image` - Image
        * `svg` - SVG
        * `audio` - Audio
    AssetUploadRequest:
      type: object
      properties:
        file:
          type: string
          format: binary
        name:
          type: string
          maxLength: 510
        tags:
          type: array
          items:
            type: string
            maxLength: 40
          maxItems: 20
      required:
      - file
    AssetUsage:
      type: object
      properties:
        used_bytes:
          type: integer
        quota_bytes:
          type: integer
      required:
      - quota_bytes
      - used_bytes
    AudioImportProviderEnum:
      enum:
      - freesound
      type: string
      description: '* `freesound` - freesound'
    AudioImportRequest:
      type: object
      properties:
        provider:
          $ref: '#/components/schemas/AudioImportProviderEnum'
        id:
          type: string
          minLength: 1
          maxLength: 12
      required:
      - id
    BackgroundRemovalModel:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        url:
          type: string
        bytes:
          type: integer
        sha256:
          type: string
        input:
          $ref: '#/components/schemas/BackgroundRemovalModelInput'
        output:
          type: string
      required:
      - bytes
      - id
      - input
      - name
      - output
      - sha256
      - url
    BackgroundRemovalModelInput:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        mean:
          type: array
          items:
            type: number
            format: double
        std:
          type: array
          items:
            type: number
            format: double
        rescale:
          $ref: '#/components/schemas/RescaleEnum'
      required:
      - mean
      - name
      - rescale
      - size
      - std
    BrandColor:
      type: object
      properties:
        id:
          type: string
          maxLength: 64
          pattern: ^[A-Za-z0-9_-]+$
        name:
          type: string
          default: ''
          maxLength: 40
        hex:
          type: string
          maxLength: 7
          pattern: ^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$
      required:
      - hex
      - id
    BrandColorRequest:
      type: object
      properties:
        id:
          type: string
          minLength: 1
          maxLength: 64
          pattern: ^[A-Za-z0-9_-]+$
        name:
          type: string
          default: ''
          maxLength: 40
        hex:
          type: string
          minLength: 1
          maxLength: 7
          pattern: ^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$
      required:
      - hex
      - id
    BrandFont:
      type: object
      properties:
        role:
          $ref: '#/components/schemas/BrandFontRoleEnum'
        family:
          type: string
          maxLength: 100
      required:
      - family
      - role
    BrandFontRequest:
      type: object
      properties:
        role:
          $ref: '#/components/schemas/BrandFontRoleEnum'
        family:
          type: string
          minLength: 1
          maxLength: 100
      required:
      - family
      - role
    BrandFontRoleEnum:
      enum:
      - heading
      - subheading
      - body
      type: string
      description: |-
        * `heading` - heading
        * `subheading` - subheading
        * `body` - body
    BrandKit:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 80
        is_default:
          type: boolean
        colors:
          type: array
          items:
            $ref: '#/components/schemas/BrandColor'
        fonts:
          type: array
          items:
            $ref: '#/components/schemas/BrandFont'
        logos:
          type: array
          items:
            $ref: '#/components/schemas/Asset'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - logos
      - name
      - updated_at
    BrandKitRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
        is_default:
          type: boolean
        colors:
          type: array
          items:
            $ref: '#/components/schemas/BrandColorRequest'
        fonts:
          type: array
          items:
            $ref: '#/components/schemas/BrandFontRequest'
        logo_ids:
          type: array
          items:
            type: string
            format: uuid
          writeOnly: true
          maxItems: 20
      required:
      - name
    BulkFillRequest:
      type: object
      properties:
        rows:
          type: array
          items:
            type: object
            additionalProperties:
              nullable: true
          minItems: 1
        row_numbers:
          type: array
          items:
            type: integer
            minimum: 1
          nullable: true
        name_pattern:
          type: string
          maxLength: 200
        folder:
          type: string
          format: uuid
          nullable: true
        export:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/ExportEnum'
          - $ref: '#/components/schemas/NullEnum'
      required:
      - rows
    BulkRequest:
      type: object
      properties:
        ids:
          type: array
          items:
            type: string
            format: uuid
          maxItems: 200
          minItems: 1
        action:
          $ref: '#/components/schemas/ActionEnum'
        folder:
          type: string
          format: uuid
          nullable: true
      required:
      - action
      - ids
    BulkResult:
      type: object
      properties:
        affected:
          type: integer
      required:
      - affected
    CategoryEnum:
      enum:
      - sans-serif
      - serif
      - display
      - handwriting
      - monospace
      type: string
      description: |-
        * `sans-serif` - Sans serif
        * `serif` - Serif
        * `display` - Display
        * `handwriting` - Handwriting
        * `monospace` - Monospace
    CategoryRef:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          readOnly: true
      required:
      - id
      - name
      - slug
    Comment:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        author:
          allOf:
          - $ref: '#/components/schemas/CommentAuthor'
          readOnly: true
        body:
          type: string
          readOnly: true
        page_id:
          type: string
          nullable: true
          readOnly: true
        x:
          type: number
          format: double
          readOnly: true
          nullable: true
        y:
          type: number
          format: double
          readOnly: true
          nullable: true
        parent:
          type: string
          format: uuid
          readOnly: true
        resolved:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - author
      - body
      - created_at
      - id
      - page_id
      - parent
      - resolved
      - x
      - y
    CommentAuthor:
      type: object
      properties:
        name:
          type: string
          readOnly: true
        avatar_url:
          type: string
          nullable: true
          readOnly: true
        id:
          type: string
          format: uuid
          readOnly: true
      required:
      - avatar_url
      - id
      - name
    CommentCreateRequest:
      type: object
      description: '`context["design_id"]` is the design the comment is written to.'
      properties:
        body:
          type: string
          minLength: 1
          maxLength: 2000
        page_id:
          nullable: true
          oneOf:
          - type: string
            maxLength: 64
            pattern: ^[A-Za-z0-9_.:-]{1,64}$
          - type: string
            maxLength: 0
        x:
          type: number
          format: double
          nullable: true
        y:
          type: number
          format: double
          nullable: true
        parent:
          type: string
          format: uuid
          nullable: true
      required:
      - body
    Design:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        title:
          type: string
          readOnly: true
        width:
          type: integer
          readOnly: true
        height:
          type: integer
          readOnly: true
        preset:
          type: string
          readOnly: true
        page_count:
          type: integer
          readOnly: true
        thumbnail_url:
          type: string
          nullable: true
          readOnly: true
        folder:
          type: string
          format: uuid
          readOnly: true
        starred:
          type: boolean
          readOnly: true
        revision:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        trashed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        document:
          type: object
          additionalProperties: true
          readOnly: true
      required:
      - created_at
      - document
      - folder
      - height
      - id
      - page_count
      - preset
      - revision
      - starred
      - thumbnail_url
      - title
      - trashed_at
      - updated_at
      - width
    DesignCreateRequest:
      type: object
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 400
        width:
          type: integer
          maximum: 20000
          minimum: 1
        height:
          type: integer
          maximum: 20000
          minimum: 1
        preset:
          oneOf:
          - type: string
            maxLength: 64
            pattern: ^[A-Za-z0-9._-]*$
          - type: string
            maxLength: 0
        document:
          type: object
          additionalProperties: true
        folder:
          type: string
          format: uuid
          nullable: true
        template:
          type: string
          minLength: 1
          maxLength: 120
          pattern: ^[-a-zA-Z0-9_]+$
    DesignSummary:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        title:
          type: string
          readOnly: true
        width:
          type: integer
          readOnly: true
        height:
          type: integer
          readOnly: true
        preset:
          type: string
          readOnly: true
        page_count:
          type: integer
          readOnly: true
        thumbnail_url:
          type: string
          nullable: true
          readOnly: true
        folder:
          type: string
          format: uuid
          readOnly: true
        starred:
          type: boolean
          readOnly: true
        revision:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        trashed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
      required:
      - created_at
      - folder
      - height
      - id
      - page_count
      - preset
      - revision
      - starred
      - thumbnail_url
      - title
      - trashed_at
      - updated_at
      - width
    ElementItem:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          readOnly: true
        kind:
          allOf:
          - $ref: '#/components/schemas/ElementKindEnum'
          readOnly: true
        style:
          allOf:
          - $ref: '#/components/schemas/ElementItemStyleEnum'
          readOnly: true
        pack:
          allOf:
          - $ref: '#/components/schemas/PackRef'
          readOnly: true
        tags:
          readOnly: true
        svg_url:
          type: string
          readOnly: true
        width:
          type: number
          format: double
          readOnly: true
        height:
          type: number
          format: double
          readOnly: true
        colors:
          readOnly: true
        is_recolorable:
          type: boolean
          readOnly: true
      required:
      - colors
      - height
      - id
      - is_recolorable
      - kind
      - name
      - pack
      - style
      - svg_url
      - tags
      - width
    ElementItemStyleEnum:
      enum:
      - outline
      - filled
      - duotone
      - colour
      type: string
      description: |-
        * `outline` - Outline
        * `filled` - Filled
        * `duotone` - Duotone
        * `colour` - Colour
    ElementKindEnum:
      enum:
      - shape
      - line
      - icon
      - sticker
      - illustration
      - frame
      - graphic
      type: string
      description: |-
        * `shape` - Shape
        * `line` - Line
        * `icon` - Icon
        * `sticker` - Sticker
        * `illustration` - Illustration
        * `frame` - Frame
        * `graphic` - Graphic
    ElementPack:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          readOnly: true
        kind:
          allOf:
          - $ref: '#/components/schemas/ElementKindEnum'
          readOnly: true
        thumbnail_url:
          type: string
          nullable: true
          description: The pack's own thumbnail, else its first element's SVG (annotated
            by the view).
          readOnly: true
        element_count:
          type: integer
          readOnly: true
        license:
          type: string
          readOnly: true
          description: SPDX identifier, e.g. CC0-1.0, MIT, Apache-2.0.
        license_url:
          type: string
          format: uri
          readOnly: true
          description: The licence text the artwork is distributed under.
        attribution:
          type: string
          readOnly: true
          description: Copyright notice(s) the licence asks to be kept with the artwork.
        source_url:
          type: string
          format: uri
          readOnly: true
          description: Where the artwork comes from (attribution).
      required:
      - attribution
      - element_count
      - id
      - kind
      - license
      - license_url
      - name
      - slug
      - source_url
      - thumbnail_url
    EmailVerifyRequest:
      type: object
      properties:
        uid:
          type: string
          minLength: 1
          maxLength: 128
        token:
          type: string
          minLength: 1
          maxLength: 128
      required:
      - token
      - uid
    ExportEnum:
      enum:
      - png
      - jpg
      type: string
      description: |-
        * `png` - png
        * `jpg` - jpg
    Field:
      type: object
      description: A template field (`doc/fields.py:list_fields`); for the API schema
        only.
      properties:
        key:
          type: string
          nullable: true
        type:
          $ref: '#/components/schemas/TypeEnum'
        label:
          type: string
          nullable: true
        pages:
          type: array
          items:
            type: integer
        object_ids:
          type: array
          items:
            type: string
        current:
          nullable: true
        fit:
          nullable: true
        overflow:
          type: boolean
      required:
      - current
      - fit
      - key
      - label
      - object_ids
      - overflow
      - pages
      - type
    FilenameStyleEnum:
      enum:
      - simple
      - structured
      type: string
      description: |-
        * `simple` - simple
        * `structured` - structured
    FillRequest:
      type: object
      properties:
        values:
          type: object
          additionalProperties:
            nullable: true
        as_copy:
          type: boolean
          default: true
        name:
          type: string
          minLength: 1
          maxLength: 400
      required:
      - values
    Folder:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          readOnly: true
        parent:
          type: string
          format: uuid
          readOnly: true
        design_count:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - design_count
      - id
      - name
      - parent
    FolderWriteRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 240
        parent:
          type: string
          format: uuid
          nullable: true
      required:
      - name
    FontFamily:
      type: object
      description: |-
        A family with one entry per weight/style. `url` is the default (Latin) file; `subsets` lists every
        per-script file, and `unicode_ranges` maps each subset to its CSS `unicode-range`, so the editor can
        load Cyrillic, Greek, etc. on demand.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        family:
          type: string
          readOnly: true
        category:
          allOf:
          - $ref: '#/components/schemas/CategoryEnum'
          readOnly: true
        scripts:
          readOnly: true
          description: Script/subset names covered by the stored files, e.g. latin.
        is_variable:
          type: boolean
          readOnly: true
        is_user_font:
          type: boolean
          readOnly: true
        variants:
          type: array
          items:
            type: object
            additionalProperties: {}
          readOnly: true
        unicode_ranges:
          type: object
          additionalProperties:
            type: string
          readOnly: true
        popularity:
          type: integer
          readOnly: true
          description: 'Rank: 1 is the most popular.'
      required:
      - category
      - family
      - id
      - is_user_font
      - is_variable
      - popularity
      - scripts
      - unicode_ranges
      - variants
    FontUploadRequest:
      type: object
      properties:
        files:
          type: array
          items:
            type: string
            format: binary
          maxItems: 5
          minItems: 1
        family:
          type: string
          maxLength: 100
        category:
          $ref: '#/components/schemas/CategoryEnum'
      required:
      - files
    FormatEnum:
      enum:
      - png
      - jpg
      - jpeg
      - webp
      type: string
      description: |-
        * `png` - png
        * `jpg` - jpg
        * `jpeg` - jpeg
        * `webp` - webp
    GoogleLoginRequest:
      type: object
      properties:
        credential:
          type: string
          minLength: 1
          maxLength: 8192
      required:
      - credential
    GoogleResult:
      type: object
      properties:
        user:
          $ref: '#/components/schemas/User'
        created:
          type: boolean
      required:
      - created
      - user
    ImageExportRequest:
      type: object
      properties:
        page:
          type: string
          nullable: true
        format:
          allOf:
          - $ref: '#/components/schemas/FormatEnum'
          default: png
        quality:
          type: integer
          maximum: 100
          minimum: 1
          default: 90
        scale:
          type: number
          format: double
          maximum: 4
          minimum: 0.1
          default: 1.0
        transparent:
          type: boolean
          default: false
        filename_style:
          $ref: '#/components/schemas/FilenameStyleEnum'
        filename_timestamp:
          type: boolean
    IssuedToken:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          readOnly: true
        prefix:
          type: string
          readOnly: true
        scopes:
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        last_used_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        expires_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        revoked_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        token:
          type: string
          readOnly: true
          description: The full token. It is shown only this once.
      required:
      - created_at
      - expires_at
      - id
      - last_used_at
      - name
      - prefix
      - revoked_at
      - scopes
      - token
    LoginRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        password:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
      required:
      - email
      - password
    NullEnum:
      enum:
      - null
    Option:
      type: object
      properties:
        id:
          type: string
          description: '`device`, or `<provider id>:<model name>`.'
        label:
          type: string
        task:
          type: string
        kind:
          $ref: '#/components/schemas/OptionKindEnum'
        provider_name:
          type: string
        owner:
          $ref: '#/components/schemas/OwnerEnum'
        sends_offsite:
          type: boolean
          description: The image leaves this installation.
      required:
      - id
      - kind
      - label
      - owner
      - provider_name
      - sends_offsite
      - task
    OptionKindEnum:
      enum:
      - device
      - server
      type: string
      description: |-
        * `device` - device
        * `server` - server
    OptionalUserEnvelope:
      type: object
      properties:
        user:
          allOf:
          - $ref: '#/components/schemas/User'
          nullable: true
      required:
      - user
    OrientationEnum:
      enum:
      - landscape
      - portrait
      - square
      type: string
      description: |-
        * `landscape` - landscape
        * `portrait` - portrait
        * `square` - square
    OwnerEnum:
      enum:
      - device
      - operator
      - user
      type: string
      description: |-
        * `device` - device
        * `operator` - operator
        * `user` - user
    PackRef:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          readOnly: true
      required:
      - id
      - name
      - slug
