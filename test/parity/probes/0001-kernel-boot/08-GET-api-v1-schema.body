openapi: 3.0.3
info:
  title: Doory API
  version: 1.0.0
  description: Open-source design platform API.
paths:
  /api/v1/ai/{task}/:
    post:
      operationId: ai_run_task
      description: Run `task` (e.g. background-removal) on one of the user's images;
        the result is a new asset.
      parameters:
      - in: path
        name: task
        schema:
          type: string
        required: true
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TaskRequestRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
        '404':
          description: Unknown task, asset or option.
        '429':
          description: Rate limit or the option's daily quota reached.
        '502':
          description: The provider failed or answered something unusable.
        '504':
          description: The provider took too long.
  /api/v1/ai/contract.yaml:
    get:
      operationId: ai_contract.yaml_retrieve
      description: The OpenAPI contract a Doory-compatible AI server implements.
      tags:
      - ai
      security:
      - {}
      responses:
        '200':
          content:
            application/yaml:
              schema:
                type: string
          description: ''
  /api/v1/ai/models/:
    get:
      operationId: ai_models_list
      description: The options the signed-in user may pick (device first), without
        URLs or secrets.
      parameters:
      - in: query
        name: task
        schema:
          type: string
        description: 'e.g. background-removal; empty: every task.'
      tags:
      - ai
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Option'
          description: ''
  /api/v1/ai/providers/:
    get:
      operationId: ai_providers_list
      tags:
      - ai
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Provider'
          description: ''
    post:
      operationId: ai_providers_create
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ProviderRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Provider'
          description: ''
  /api/v1/ai/providers/{id}/:
    get:
      operationId: ai_providers_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - ai
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Provider'
          description: ''
    patch:
      operationId: ai_providers_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedProviderRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Provider'
          description: ''
    delete:
      operationId: ai_providers_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - ai
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/ai/providers/{id}/load-models/:
    post:
      operationId: ai_providers_load_models_create
      description: 'Doory-compatible servers: add the models the server lists for
        the provider''s tasks.'
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - ai
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Provider'
          description: ''
  /api/v1/ai/providers/{id}/models/:
    put:
      operationId: ai_providers_models_update
      description: Replace the provider's models (which to offer, their labels and
        order).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ProviderModelsRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Provider'
          description: ''
  /api/v1/ai/providers/{id}/test/:
    post:
      operationId: ai_providers_test_create
      description: Send a built-in sample picture and report the outcome, the time
        taken and a small preview.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ProviderTestRequestRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ProviderTestResult'
          description: ''
  /api/v1/assets/:
    get:
      operationId: assets_list
      parameters:
      - in: query
        name: kind
        schema:
          type: string
          enum:
          - audio
          - image
          - svg
        description: Without it the list holds images and SVG; audio is listed only
          with kind=audio.
      - in: query
        name: ordering
        schema:
          type: string
        description: created_at, name or size; prefix - to reverse.
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: q
        schema:
          type: string
        description: Case-insensitive name search.
      tags:
      - assets
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetList'
          description: ''
    post:
      operationId: assets_create
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetUploadRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetUploadRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
  /api/v1/assets/{id}/:
    get:
      operationId: assets_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - assets
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
    patch:
      operationId: assets_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAssetUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAssetUpdateRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
    delete:
      operationId: assets_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - assets
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/assets/usage/:
    get:
      operationId: assets_usage_retrieve
      tags:
      - assets
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetUsage'
          description: ''
  /api/v1/auth/csrf/:
    get:
      operationId: auth_csrf_retrieve
      description: Sets the `csrftoken` cookie; the SPA echoes it in `X-CSRFToken`
        on unsafe requests.
      tags:
      - auth
      security:
      - {}
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/email/resend/:
    post:
      operationId: auth_email_resend_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      security:
      - cookieAuth: []
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/email/verify/:
    post:
      operationId: auth_email_verify_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmailVerifyRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/EmailVerifyRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EmailVerifyRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/google/:
    post:
      operationId: auth_google_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GoogleLoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/GoogleLoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/GoogleLoginRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GoogleResult'
          description: ''
  /api/v1/auth/login/:
    post:
      operationId: auth_login_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserEnvelope'
          description: ''
  /api/v1/auth/logout/:
    post:
      operationId: auth_logout_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      security:
      - cookieAuth: []
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/me/:
    get:
      operationId: auth_me_retrieve
      description: The current user. `GET` never fails for anonymous callers so the
        SPA can bootstrap.
      tags:
      - auth
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OptionalUserEnvelope'
          description: ''
    patch:
      operationId: auth_me_partial_update
      description: The current user. `GET` never fails for anonymous callers so the
        SPA can bootstrap.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedProfileUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedProfileUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedProfileUpdateRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserEnvelope'
          description: ''
    delete:
      operationId: auth_me_destroy
      description: The current user. `GET` never fails for anonymous callers so the
        SPA can bootstrap.
      tags:
      - auth
      security:
      - cookieAuth: []
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/password/change/:
    post:
      operationId: auth_password_change_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordChangeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordChangeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordChangeRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/password/reset/:
    post:
      operationId: auth_password_reset_create
      description: Always answers 204 so the endpoint cannot be used to discover which
        emails have accounts.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetRequestRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/password/reset/confirm/:
    post:
      operationId: auth_password_reset_confirm_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirmRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirmRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirmRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '204':
          description: Done; no body.
  /api/v1/auth/register/:
    post:
      operationId: auth_register_create
      description: 'Base for the credential endpoints: CSRF-protected, per-IP `auth`
        throttle.'
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserEnvelope'
          description: ''
  /api/v1/auth/tokens/:
    get:
      operationId: auth_tokens_list
      tags:
      - api-tokens
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ApiToken'
          description: ''
    post:
      operationId: auth_tokens_create
      tags:
      - api-tokens
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ApiTokenCreateRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/IssuedToken'
          description: ''
  /api/v1/auth/tokens/{id}/:
    delete:
      operationId: auth_tokens_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api-tokens
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/auth/tokens/scopes/:
    get:
      operationId: auth_tokens_scopes_list
      tags:
      - api-tokens
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Scope'
          description: ''
  /api/v1/brand-kits/:
    get:
      operationId: brand_kits_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - brand-kits
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedBrandKitList'
          description: ''
    post:
      operationId: brand_kits_create
      tags:
      - brand-kits
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BrandKitRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BrandKit'
          description: ''
  /api/v1/brand-kits/{id}/:
    get:
      operationId: brand_kits_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - brand-kits
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BrandKit'
          description: ''
    patch:
      operationId: brand_kits_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - brand-kits
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedBrandKitRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BrandKit'
          description: ''
    delete:
      operationId: brand_kits_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - brand-kits
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/collab/stats/:
    get:
      operationId: collab_stats_retrieve
      description: Live rooms and connections (rows with a recent heartbeat) and the
        per-process counters.
      tags:
      - collab
      security:
      - cookieAuth: []
      responses:
        '200':
          description: Rooms, connections and counters.
  /api/v1/config/:
    get:
      operationId: config_retrieve
      description: 'Public runtime configuration: optional integrations, size limits
        and the models to download.'
      tags:
      - system
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AppConfig'
          description: ''
  /api/v1/designs/:
    get:
      operationId: designs_list
      parameters:
      - in: query
        name: folder
        schema:
          type: string
        description: A folder id, or `root` for the top level.
      - in: query
        name: ordering
        schema:
          type: string
        description: updated_at, created_at or title; prefix - to reverse.
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: q
        schema:
          type: string
        description: Title search (case-insensitive).
      - in: query
        name: starred
        schema:
          type: boolean
      - in: query
        name: trashed
        schema:
          type: boolean
        description: List the trash instead of live designs.
      tags:
      - designs
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDesignSummaryList'
          description: ''
    post:
      operationId: designs_create
      tags:
      - designs
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DesignCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/DesignCreateRequest'
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Design'
          description: ''
  /api/v1/designs/{design_id}/comments/:
    get:
      operationId: designs_comments_list
      description: Applies the `upload` rate (on top of the default throttles) to
        the listed methods only.
      parameters:
      - in: path
        name: design_id
        schema:
          type: string
          format: uuid
        required: true
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: page_id
        schema:
          type: string
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: resolved
        schema:
          type: boolean
      tags:
      - comments
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCommentList'
          description: ''
    post:
      operationId: designs_comments_create
      description: Applies the `upload` rate (on top of the default throttles) to
        the listed methods only.
      parameters:
      - in: path
        name: design_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - comments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CommentCreateRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Comment'
          description: ''
  /api/v1/designs/{design_id}/comments/{id}/:
    patch:
      operationId: designs_comments_partial_update
      description: 'Owner only: mark a thread as resolved / re-open it, move its pin,
        or edit one''s own comment.'
      parameters:
      - in: path
        name: design_id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - comments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedCommentUpdateRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Comment'
          description: ''
    delete:
      operationId: designs_comments_destroy
      description: The design owner can delete any comment; everybody else only their
        own.
      parameters:
      - in: path
        name: design_id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - comments
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/designs/{design_id}/share-links/:
    get:
      operationId: designs_share_links_list
      description: 'Base for `/designs/{design_id}/...` endpoints: only the owner
        can see the design (404 otherwise).'
