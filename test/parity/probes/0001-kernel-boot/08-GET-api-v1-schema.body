    TypeEnum:
      enum:
      - text
      - image
      - color
      type: string
      description: |-
        * `text` - text
        * `image` - image
        * `color` - color
    User:
      type: object
      description: The signed-in user's own profile. Never exposes hashes, tokens
        or other users' data.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        email:
