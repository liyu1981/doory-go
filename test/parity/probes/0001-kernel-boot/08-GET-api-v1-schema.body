            application/json:
              schema:
                $ref: '#/components/schemas/Design'
          description: ''
  /api/v1/designs/{id}/:
    get:
      operationId: designs_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - designs
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Design'
          description: ''
    patch:
      operationId: designs_partial_update
      description: Saving `document` needs `base_revision`; a stale value answers
        409 `revision_conflict`.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - designs
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedDesignUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedDesignUpdateRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Design'
          description: ''
        '409':
          description: No response body
    delete:
      operationId: designs_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      - in: query
        name: permanent
        schema:
          type: boolean
        description: Hard-delete (only from the trash).
      tags:
      - designs
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/designs/{id}/bulk-fill/:
    post:
      operationId: designs_bulk_fill_create
      description: 'One new design per row, filled like `fill`; each row reports its
        design or its error. Each row counts against the `bulk_fill` rate, each new
        image URL against `bulk_fill_images` and each exported image against `export`;
        a row over a limit reports its error. Image URLs are fetched only when URL_IMAGE_UPLOADS
        is on. Many URL images or exports make a long request: keep it under the worker
        timeout with fewer rows. One fill or bulk fill per user runs at a time; another
        one meanwhile is a 429.'
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - designs
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BulkFillRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BulkFillRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/designs/{id}/duplicate/:
    post:
      operationId: designs_duplicate_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - designs
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Design'
          description: ''
  /api/v1/designs/{id}/export/image/:
    post:
      operationId: designs_export_image_create
      description: Render one page of a saved design as PNG, JPG or WebP on the server,
        as the editor draws it.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - exports
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ImageExportRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ImageExportRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ImageExportRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            image/png:
              schema:
                type: string
                format: binary
            image/jpeg:
              schema:
                type: string
                format: binary
            image/webp:
              schema:
                type: string
                format: binary
          description: ''
  /api/v1/designs/{id}/fields/:
    get:
      operationId: designs_fields_list
      description: 'The template fields of the design: tagged objects, one entry per
        key, and photo placeholders without a tag (`key: null`).'
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - designs
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedFieldList'
          description: ''
  /api/v1/designs/{id}/fill/:
    post:
      operationId: designs_fill_create
      description: 'Fill the template fields by key ({key: value}); by default into
        a new copy (201). All or nothing: a bad value is a 400 naming its key. Image
        values may be public https URLs when URL_IMAGE_UPLOADS is on (the server copies
        them into your uploads).'
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
        required: true
      tags:
      - designs
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FillRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FillRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
        '201':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/designs/{id}/restore/:
    post:
      operationId: designs_restore_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          pattern: ^[0-9a-fA-F-]{36}$
