        asset_id:
          type: string
          format: uuid
        model:
          type: string
          minLength: 1
          description: An option id from GET /api/v1/ai/models/.
          maxLength: 300
        options:
          type: object
          additionalProperties: {}
          description: Task options (none for now).
      required:
      - asset_id
      - model
    TasksEnum:
      enum:
      - background-removal
      type: string
      description: '* `background-removal` - background-removal'
    TemplateCategory:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          readOnly: true
        icon:
