    PasswordChangeRequest:
      type: object
      properties:
        old_password:
          type: string
          writeOnly: true
          maxLength: 128
        new_password:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
      required:
      - new_password
    PasswordResetConfirmRequest:
      type: object
      properties:
        uid:
          type: string
          minLength: 1
          maxLength: 128
        token:
          type: string
          minLength: 1
          maxLength: 128
        new_password:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
      required:
      - new_password
      - token
      - uid
    PasswordResetRequestRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
      required:
      - email
    PatchedAssetUpdateRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 510
        tags:
          type: array
          items:
            type: string
            maxLength: 40
          maxItems: 20
    PatchedBrandKitRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
        is_default:
          type: boolean
        colors:
          type: array
          items:
            $ref: '#/components/schemas/BrandColorRequest'
        fonts:
          type: array
          items:
            $ref: '#/components/schemas/BrandFontRequest'
        logo_ids:
          type: array
          items:
            type: string
            format: uuid
          writeOnly: true
          maxItems: 20
    PatchedCommentMoveRequest:
      type: object
      description: 'PATCH through a share link: the author moves the pin of their
        own thread (nothing else).'
      properties:
        page_id:
          nullable: true
          oneOf:
          - type: string
            maxLength: 64
            pattern: ^[A-Za-z0-9_.:-]{1,64}$
          - type: string
            maxLength: 0
        x:
          type: number
          format: double
          nullable: true
        y:
          type: number
          format: double
          nullable: true
    PatchedCommentUpdateRequest:
      type: object
      description: |-
        Owner PATCH: resolve or re-open a thread and/or move its pin (top-level comments only), and change the
        text of a comment the requesting user wrote (`context["user"]`).
      properties:
        page_id:
          nullable: true
          oneOf:
          - type: string
            maxLength: 64
            pattern: ^[A-Za-z0-9_.:-]{1,64}$
          - type: string
            maxLength: 0
        x:
          type: number
          format: double
          nullable: true
        y:
          type: number
          format: double
          nullable: true
        resolved:
          type: boolean
        body:
          type: string
          minLength: 1
          maxLength: 2000
    PatchedDesignUpdateRequest:
      type: object
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 400
        document:
          type: object
          additionalProperties: true
        base_revision:
          type: integer
          minimum: 1
        folder:
          type: string
          format: uuid
          nullable: true
        starred:
          type: boolean
    PatchedFolderWriteRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 240
        parent:
          type: string
          format: uuid
          nullable: true
    PatchedProfileUpdateRequest:
      type: object
      properties:
        display_name:
          type: string
          maxLength: 80
        avatar:
          type: string
          format: binary
          writeOnly: true
        remove_avatar:
          type: boolean
          writeOnly: true
    PatchedProviderRequest:
      type: object
      description: 'A user''s own provider. The secret is write-only: it is never
        returned, only whether one is set.'
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
        base_url:
          type: string
          minLength: 1
          description: The server's address, e.g. https://ai.example.com
          maxLength: 500
        style:
          allOf:
          - $ref: '#/components/schemas/ProviderStyleEnum'
          default: doory
        style_config: {}
        auth_header:
          type: string
          description: 'e.g. Authorization or X-Api-Key; empty: no authentication.'
          maxLength: 64
        secret:
          type: string
          writeOnly: true
          description: The value of the auth header (e.g. `Bearer …`). Omit to keep
            the stored one; empty to remove it. Changing the server's scheme, host
            or port while a secret is stored is refused unless a new one (or an empty
            one) is sent in the same request.
          maxLength: 4096
        tasks:
          type: array
          items:
            $ref: '#/components/schemas/TasksEnum'
          maxItems: 1
        timeout_seconds:
          type: integer
          maximum: 60
          minimum: 1
        max_image_bytes:
          type: integer
          maximum: 26214400
          minimum: 0
          description: 'Largest source image sent to this server; 0: the server-wide
            limit.'
        sends_offsite:
          type: boolean
          description: Images leave this installation (shown as a privacy notice in
            the editor).
        enabled:
          type: boolean
        sort_order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
    PatchedShareLinkUpdateRequest:
      type: object
      properties:
        role:
          $ref: '#/components/schemas/ShareRoleEnum'
        expires_at:
          type: string
          format: date-time
          nullable: true
        is_active:
          type: boolean
        password:
          writeOnly: true
          nullable: true
          oneOf:
          - type: string
            maxLength: 128
            minLength: 4
          - type: string
            maxLength: 0
    PatchedSharedSaveRequest:
      type: object
      properties:
        document: {}
        base_revision:
          type: integer
          minimum: 1
    PdfExportDocumentationRequest:
      type: object
      description: OpenAPI description of the multipart body.
      properties:
        width:
          type: number
          format: double
          maximum: 20000
          minimum: 1
        height:
          type: number
          format: double
          maximum: 20000
          minimum: 1
        sizes:
          type: string
          maxLength: 16384
        bleed_mm:
          type: number
          format: double
          maximum: 10
          minimum: 0
          default: 0.0
        crop_marks:
          type: boolean
          default: false
        title:
          type: string
          default: ''
          maxLength: 200
        lang:
          type: string
          minLength: 1
          default: en
          pattern: ^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$
        fonts:
          type: string
          default: ''
          maxLength: 65536
        pages:
          type: array
          items:
            type: string
            format: binary
          maxItems: 100
          minItems: 1
      required:
      - height
      - pages
      - width
    Provider:
      type: object
      description: 'A user''s own provider. The secret is write-only: it is never
        returned, only whether one is set.'
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 80
        base_url:
          type: string
          description: The server's address, e.g. https://ai.example.com
          maxLength: 500
        style:
          allOf:
          - $ref: '#/components/schemas/ProviderStyleEnum'
          default: doory
        style_config: {}
        auth_header:
          type: string
          description: 'e.g. Authorization or X-Api-Key; empty: no authentication.'
          maxLength: 64
        has_secret:
          type: boolean
          readOnly: true
        tasks:
          type: array
          items:
            $ref: '#/components/schemas/TasksEnum'
          maxItems: 1
        timeout_seconds:
          type: integer
          maximum: 60
          minimum: 1
        max_image_bytes:
          type: integer
          maximum: 26214400
          minimum: 0
          description: 'Largest source image sent to this server; 0: the server-wide
            limit.'
        sends_offsite:
          type: boolean
          description: Images leave this installation (shown as a privacy notice in
            the editor).
        enabled:
          type: boolean
        sort_order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        models:
          type: array
          items:
            $ref: '#/components/schemas/ProviderModel'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - base_url
      - created_at
      - has_secret
      - id
      - models
      - name
      - tasks
      - updated_at
    ProviderModel:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        task:
          type: string
          maxLength: 64
        remote_name:
          type: string
          maxLength: 200
        label:
          type: string
          maxLength: 80
        enabled:
          type: boolean
        sort_order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
      required:
      - id
      - task
    ProviderModelRequest:
      type: object
      properties:
        task:
          type: string
          minLength: 1
          maxLength: 64
        remote_name:
          type: string
          maxLength: 200
        label:
          type: string
          maxLength: 80
        enabled:
          type: boolean
        sort_order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
      required:
      - task
    ProviderModelsRequest:
      type: object
      properties:
        models:
          type: array
          items:
            $ref: '#/components/schemas/ProviderModelRequest'
      required:
      - models
    ProviderRequest:
      type: object
      description: 'A user''s own provider. The secret is write-only: it is never
        returned, only whether one is set.'
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
        base_url:
          type: string
          minLength: 1
          description: The server's address, e.g. https://ai.example.com
          maxLength: 500
        style:
          allOf:
          - $ref: '#/components/schemas/ProviderStyleEnum'
          default: doory
        style_config: {}
        auth_header:
          type: string
          description: 'e.g. Authorization or X-Api-Key; empty: no authentication.'
          maxLength: 64
        secret:
          type: string
          writeOnly: true
          description: The value of the auth header (e.g. `Bearer …`). Omit to keep
            the stored one; empty to remove it. Changing the server's scheme, host
            or port while a secret is stored is refused unless a new one (or an empty
            one) is sent in the same request.
          maxLength: 4096
        tasks:
          type: array
          items:
            $ref: '#/components/schemas/TasksEnum'
          maxItems: 1
        timeout_seconds:
          type: integer
          maximum: 60
          minimum: 1
        max_image_bytes:
          type: integer
          maximum: 26214400
          minimum: 0
          description: 'Largest source image sent to this server; 0: the server-wide
            limit.'
        sends_offsite:
          type: boolean
          description: Images leave this installation (shown as a privacy notice in
            the editor).
        enabled:
          type: boolean
        sort_order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
      required:
      - base_url
      - name
      - tasks
    ProviderStyleEnum:
      enum:
      - doory
      - multipart
      - json
      - mask
      - custom
      type: string
      description: |-
        * `doory` - Doory-compatible
        * `multipart` - Multipart → image
        * `json` - JSON → base64
        * `mask` - Mask
        * `custom` - Custom
    ProviderTestRequestRequest:
      type: object
      properties:
        task:
          type: string
          minLength: 1
          description: 'Default: the provider''s first task.'
        model:
          type: string
          description: 'Default: the first enabled model.'
          maxLength: 200
    ProviderTestResult:
      type: object
      properties:
        ok:
          type: boolean
        duration_ms:
          type: integer
        task:
          type: string
        model:
          type: string
        preview:
          type: string
          description: 'data: URL of the result (PNG, at most 256 px), when it worked.'
        error:
          type: object
          additionalProperties:
            type: string
          nullable: true
      required:
      - duration_ms
      - error
      - model
      - ok
      - preview
      - task
    PublicUser:
      type: object
      properties:
        name:
          type: string
          readOnly: true
        avatar_url:
          type: string
          nullable: true
          readOnly: true
      required:
      - avatar_url
      - name
    RegisterRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        password:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
        display_name:
          type: string
          default: ''
          maxLength: 80
      required:
      - email
      - password
    RescaleEnum:
      enum:
      - max
      - '255'
      type: string
      description: |-
        * `max` - max
        * `255` - 255
    Scope:
      type: object
      properties:
        id:
          type: string
        description:
          type: string
      required:
      - description
      - id
    ScopesEnum:
      enum:
      - assets:write
      - brand:write
      - comments:manage
      - comments:write
      - designs:read
      - designs:trash
      - designs:write
      - sharing:write
      type: string
      description: |-
        * `assets:write` - assets:write
        * `brand:write` - brand:write
        * `comments:manage` - comments:manage
        * `comments:write` - comments:write
        * `designs:read` - designs:read
        * `designs:trash` - designs:trash
        * `designs:write` - designs:write
        * `sharing:write` - sharing:write
    ShareLink:
      type: object
      description: Owner view of a link (and the response of create/update).
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        token:
          type: string
          readOnly: true
        role:
          allOf:
          - $ref: '#/components/schemas/ShareRoleEnum'
          readOnly: true
        url:
          type: string
          readOnly: true
        is_active:
          type: boolean
          readOnly: true
        expires_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        has_password:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - expires_at
      - has_password
      - id
      - is_active
      - role
      - token
      - url
    ShareLinkCreateRequest:
      type: object
      properties:
        role:
          $ref: '#/components/schemas/ShareRoleEnum'
        expires_at:
          type: string
          format: date-time
          nullable: true
        password:
          writeOnly: true
          nullable: true
          oneOf:
          - type: string
            maxLength: 128
            minLength: 4
          - type: string
            maxLength: 0
      required:
      - role
    ShareRoleEnum:
      enum:
      - view
      - comment
      - edit
      type: string
      description: |-
        * `view` - Can view
        * `comment` - Can comment
        * `edit` - Can edit
    SharedDesign:
      type: object
      description: |-
        What an anonymous viewer is allowed to learn about a design. `fonts` are the owner's uploaded font
        families that the document names, so the viewer's browser can draw the text as the owner sees it.
      properties:
        design_id:
          type: string
          format: uuid
        role:
          type: string
        title:
          type: string
        width:
          type: integer
        height:
          type: integer
        revision:
          type: integer
        owner:
          $ref: '#/components/schemas/PublicUser'
        document: {}
        fonts:
          type: array
          items:
            $ref: '#/components/schemas/FontFamily'
      required:
      - design_id
      - document
      - fonts
      - height
      - owner
      - revision
      - role
      - title
      - width
    SharedSaveResult:
      type: object
      properties:
        revision:
          type: integer
        updated_at:
          type: string
          format: date-time
      required:
      - revision
      - updated_at
    StockImportProviderEnum:
