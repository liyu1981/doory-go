        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ShareLink'
          description: ''
    delete:
      operationId: designs_share_links_destroy
      description: 'Revoke: the link stops working immediately and disappears from
        the list.'
      parameters:
      - in: path
        name: design_id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: id
