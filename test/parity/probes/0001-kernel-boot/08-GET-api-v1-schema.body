      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ShareLink'
          description: ''
    patch:
      operationId: designs_share_links_partial_update
      description: 'Base for `/designs/{design_id}/...` endpoints: only the owner
        can see the design (404 otherwise).'
      parameters:
      - in: path
        name: design_id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: id
        schema:
