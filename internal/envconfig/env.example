# Doory environment template for the single binary.
# template-version: 1
#
# Every setting the binary reads is listed here with its default (the two
# upstream-compatibility names marked "not read yet" are the exception).
# `doory serve` and `doory entrypoint` run without any of it (SQLite database,
# media and exports under ./data, listener on :8111). Copy this file to a
# `.env` with `doory config init`, then fill in the values you need:
#
#   doory config init                 # writes ./.env from this template
#   doory config upgrade              # re-adds new settings, keeps your values
#
# A ./.env is not loaded implicitly: pass it with --env-file, or keep the file
# at the default user path (~/.config/doory/.env).
#
# The binary reads, in increasing priority:
#   1. ~/.config/doory/.env (or $XDG_CONFIG_HOME/doory/.env) when present;
#   2. a file passed on the command line: doory --env-file /path/to/.env serve;
#   3. variables already present in the process environment.
# Process environment values always win, so secrets can stay in systemd's
# EnvironmentFile while the rest lives in the user config file.
#
# The template itself is also valid as a systemd EnvironmentFile. The binary
# additionally accepts `export KEY=value`, but systemd does not, so stay with
# plain KEY=value in a file used by both.

# ---- Public address / Django core ----
# Public origin, with scheme and no trailing slash (emails, CSRF checks,
# exported links). Change the port if DOORY_ADDR is not :8080.
SITE_URL=http://localhost:8080
# Long random value: openssl rand -base64 48
# Changing it signs everyone out. Leave empty only on localhost: the binary
# then uses its built-in development key.
# DJANGO_SECRET_KEY=
# Hostnames the API answers to, comma separated. A leading dot also matches
# subdomains (for example .example.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to submit unsafe requests. Defaults to SITE_URL when empty.
# CSRF_TRUSTED_ORIGINS=https://doory.example.com
# Extra origins allowed to call the API from a browser (CORS).
# CORS_ALLOWED_ORIGINS=
# Previously rotated signing keys, comma separated. Keeps old sessions valid
# while a new DJANGO_SECRET_KEY is rolled out.
# SECRET_KEY_FALLBACKS=
# Enable Django-style debug errors. Never enable on a public install.
# DJANGO_DEBUG=false

# ---- Listener / health probe ----
# The address is normally the positional argument of `serve`/`entrypoint`
# (`doory serve :8111`). DOORY_ADDR changes the default.
# DOORY_ADDR=:8111
# `doory healthcheck` probes this port/path and exits 0 only on HTTP 200.
# HEALTH_PORT=8111
# HEALTH_PATH=/api/v1/health/

# ---- Storage (D4) ----
# One directory holds everything that must survive: doory.sqlite3, media/,
# exports/. Point WorkingDirectory or DOORY_DATA_DIR at the volume you back up.
DOORY_DATA_DIR=./data
# Default: sqlite:///<DOORY_DATA_DIR>/doory.sqlite3.
# PostgreSQL uses the same binary: postgres://user:pass@host:5432/db
# DATABASE_URL=postgres://doory:secret@db:5432/doory
# Override the individual paths if they live elsewhere.
# MEDIA_ROOT=./data/media
# EXPORT_STORAGE_ROOT=./data/exports
# EXPORT_WORK_DIR=

# ---- HTTPS / proxy ----
# Secure flag on session and CSRF cookies. Keep false for plain http://localhost;
# set true behind a TLS-terminating proxy.
SECURE_COOKIES=false
# Accepted for upstream compatibility; this binary does not read them yet.
# Terminate TLS in the reverse proxy instead.
# SECURE_SSL_REDIRECT=false
# NUM_PROXIES=1

# ---- Admin / first superuser ----
# Used by `doory createsuperuser --noinput` (password may also be passed as
# --email and typed interactively).
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=

# ---- Email ----
# consolemail:// prints messages to stdout. Use smtp://user:pass@host:587/?tls=true
# (or an Email_URL supported by the port) for real delivery.
# EMAIL_URL=consolemail://
# EMAIL_SEND_ASYNC=true
# Seconds a user must wait between verification/reset emails.
# AUTH_EMAIL_COOLDOWN_SECONDS=60

# ---- Authentication / SSO ----
# Google sign-in: the web-application OAuth client id. The backend verifies
# the Google ID token, so sign-in completes end to end.
# GOOGLE_CLIENT_ID=
# Generic OIDC SSO (Google is an OIDC provider too): discovery, PKCE, JWKS and
# token verification are built in. Register the callback
# /api/v1/auth/oidc/callback/ in the provider.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_TRUST_EMAIL=false
# OIDC_BUTTON_LABEL=Sign in with SSO
# OIDC_BUTTON_ICON=

# ---- Server-side export (needs Chromium on the host) ----
# SERVER_PDF_ENABLED=true
# SERVER_IMAGE_EXPORT_ENABLED=false
# EXPORT_CHROMIUM_PATH=/usr/bin/chromium
# EXPORT_CHROMIUM_NO_SANDBOX=true
# EXPORT_RENDER_PAGE_URL=http://localhost:8080/render.html
# EXPORT_FILENAME_STYLE=simple
# EXPORT_FILENAME_TIMESTAMP=false
# EXPORT_IMAGE_MAX_PIXELS=40000000
# EXPORT_IMAGE_MAX_DOCUMENT_BYTES=5242880
# EXPORT_MAX_CONCURRENCY=2
# EXPORT_TIMEOUT_SECONDS=30
# EXPORT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8111

# ---- Image optimizers ----
# Built-in optimizer always available. tinypng/kraken/custom need keys.
# IMAGE_OPTIMIZERS=builtin
# IMAGE_OPTIMIZER_DEFAULT=builtin
# IMAGE_OPTIMIZER_CUSTOM_NAME=Custom
# IMAGE_OPTIMIZER_CUSTOM_URL=
# IMAGE_OPTIMIZER_CUSTOM_KEY=
# IMAGE_OPTIMIZER_MAX_BYTES=26214400
# Per-file optimizer deadline in seconds.
# IMAGE_OPTIMIZER_TIMEOUT=30
# TINYPNG_API_KEY=
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# ---- Real-time co-editing ----
# REALTIME_ENABLED=true
# REALTIME_MAX_FRAME_BYTES=1048576
# REALTIME_MAX_CONNECTIONS_PER_DESIGN=25
# REALTIME_MAX_CONNECTIONS_PER_USER=10
# REALTIME_AUTH_TIMEOUT_SECONDS=10
# REALTIME_IDLE_TIMEOUT_SECONDS=120
# REALTIME_FLUSH_INTERVAL_SECONDS=10
# REALTIME_RECHECK_SECONDS=5
# REALTIME_COMPACT_AFTER_UPDATES=200
# REALTIME_SLOW_APPLY_SECONDS=2.0
# REALTIME_CONNECTS_PER_MINUTE=60
# REALTIME_BLOCK_SECONDS=600
# REALTIME_RATE_MESSAGES_PER_SECOND=100
# REALTIME_RATE_BURST=300
# REALTIME_RATE_BYTES_PER_SECOND=1048576
# REALTIME_RATE_BYTES_BURST=4194304

# ---- MCP server for AI assistants (/mcp) ----
# Off by default; clients authenticate with a personal access token.
# MCP_ENABLED=false
# MCP_PATH=/mcp
# MCP_CALLS_PER_MINUTE=120
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_EXPORT_INLINE_MAX_BYTES=1048576
# MCP_EXPORT_URL_TTL_SECONDS=600
# Allow URL image uploads (also used by bulk fill and remote fetch).
# URL_IMAGE_UPLOADS=true

# ---- First-run content (`doory entrypoint`) ----
# The embedded content (elements, audio, starter templates) is installed on
# every entrypoint start by default (D19); these flags let you opt out.
# The font catalog and background-removal model download from the internet and
# stay off until enabled. A failed download is logged and never stops the server.
# Element library (icons, emoji, illustrations, shapes, graphics).
# DOORY_SYNC_ELEMENTS=true
# Extra arguments for `sync_element_packs`, e.g. --pack lucide phosphor-regular
# DOORY_SYNC_ELEMENTS_ARGS=
# Brand logos are trademarks of their owners; false unpublishes them on next sync.
# DOORY_ELEMENTS_BRAND_LOGOS=false
# Font catalog (OFL fonts from Fontsource via jsDelivr).
# DOORY_SYNC_FONTS=false
# Which families (default when empty: the 100 most popular, about 6 MB).
# DOORY_SYNC_FONTS_ARGS=--popular 100
# The ten starter templates and the 11 font families their documents name
# (embedded, no download). Add-only: an existing template is never changed.
# DOORY_SEED_TEMPLATES=true
# DOORY_SEED_TEMPLATE_FONTS=true
# Background-removal model (U2-Net small, Apache-2.0, 4.6 MB).
# DOORY_SYNC_MODELS=false
# Extra arguments for `sync_models`, e.g. --model u2net (176 MB) or --all
# DOORY_SYNC_MODELS_ARGS=
# Audio library (24 music loops and 88 sound effects, CC0, about 7 MB).
# DOORY_SYNC_AUDIO=true
# Extra arguments for `sync_audio`, e.g. --pack some-pack
# DOORY_SYNC_AUDIO_ARGS=
# Your own size presets catalogue (JSON; see `doory import_size_presets`).
# DOORY_SIZE_PRESETS_FILE=/config/size-presets.json
# DOORY_SIZE_PRESETS_MODE=extend

# ---- AI providers (optional) ----
# AI_PROVIDERS_ENABLED=true
# AI_USER_PROVIDERS=off        # off | staff | everyone
# AI_OFFSITE_NOTICE=
# Fernet key; defaults to one derived from DJANGO_SECRET_KEY.
# Generate with: doory reencrypt_ai_secrets --help
# AI_SECRETS_KEY=
# AI_SECRETS_KEY_FALLBACKS=
# AI_ALLOWED_PRIVATE_HOSTS=
# AI_DEFAULT_TIMEOUT_SECONDS=60
# AI_MAX_IMAGE_BYTES=26214400
# AI_MAX_PROVIDERS_PER_USER=10
# AI_USER_PROVIDERS_ALLOW_HTTP=false
# AI_USER_PROVIDERS_ALLOWED_PORTS=

# Operator-declared AI providers. Slots 1..9 are supported; a slot is used when
# its URL is set. Repeat this block for AI_PROVIDER_2_* .. AI_PROVIDER_9_*.
# AI_PROVIDER_1_URL=http://127.0.0.1:8000
# AI_PROVIDER_1_STYLE=doory
# AI_PROVIDER_1_TASKS=background-removal
# AI_PROVIDER_1_MODELS=model-id:Model label,other-id:Other label
# AI_PROVIDER_1_AUTH_HEADER=
# AI_PROVIDER_1_AUTH_VALUE=
# AI_PROVIDER_1_STYLE_CONFIG=
# AI_PROVIDER_1_LABEL=Server 1
# AI_PROVIDER_1_SENDS_OFFSITE=false
# AI_PROVIDER_1_TIMEOUT_SECONDS=60
# AI_PROVIDER_1_MAX_IMAGE_BYTES=26214400
# AI_PROVIDER_1_DAILY_QUOTA=0
# Background-removal model pin and default task target.
# BACKGROUND_REMOVAL_MODEL=
# BACKGROUND_REMOVAL_DEFAULT=device

# ---- Stock photo / video / sound providers ----
# Empty keys mean the no-configuration behaviour.
# STOCK_PROVIDERS=unsplash,pexels,pixabay
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# FREESOUND_ACCESS_KEY=
# STOCK_VIDEO_PROVIDERS=pexels_video,pixabay_video
# PEXELS_VIDEO_API_KEY=
# PIXABAY_VIDEO_API_KEY=

# ---- Video assets ----
# VIDEO_ENABLED=true
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# MAX_VIDEO_UPLOAD_BYTES=209715200
# MAX_VIDEO_DURATION_SECONDS=600

# ---- Limits ----
# MAX_DESIGNS_PER_USER=5000
# MAX_API_TOKENS_PER_USER=20
# USER_STORAGE_QUOTA_BYTES=2147483648
# BULK_FILL_MAX_ROWS=100

# ---- Local development ----
# Serve the API while proxying every page request to the Vite dev server
# (the mirror image of frontend/vite.config.ts's server.proxy).
# DOORY_DEV_PROXY=http://127.0.0.1:5173
